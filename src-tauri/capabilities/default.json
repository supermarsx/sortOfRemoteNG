{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables the application permissions for the main window and detached session windows only. The splash window is intentionally excluded from IPC access. NOTE: 'core:webview:allow-internal-toggle-devtools' authorizes Tauri's built-in internal_toggle_devtools command, which Tauri gates behind cfg(any(debug_assertions, feature = \"devtools\")). Since the 'devtools' Tauri feature is NOT enabled (see src-tauri/Cargo.toml), this permission is inert in release builds (the underlying command does not exist) and only active in debug builds.",
  "windows": ["main", "detached-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-center",
    "core:window:allow-inner-position",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-visible",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-set-background-color",
    "core:window:allow-get-all-windows",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/com.sortofremote.ng" },
        { "path": "$APPDATA/com.sortofremote.ng/**" },
        { "path": "$APPDATA/sortofremoteng" },
        { "path": "$APPDATA/sortofremoteng/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/com.sortofremote.ng" },
        { "path": "$APPDATA/com.sortofremote.ng/**" },
        { "path": "$APPDATA/sortofremoteng" },
        { "path": "$APPDATA/sortofremoteng/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/com.sortofremote.ng" },
        { "path": "$APPDATA/com.sortofremote.ng/**" },
        { "path": "$APPDATA/sortofremoteng" },
        { "path": "$APPDATA/sortofremoteng/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/com.sortofremote.ng" },
        { "path": "$APPDATA/com.sortofremote.ng/**" },
        { "path": "$APPDATA/sortofremoteng" },
        { "path": "$APPDATA/sortofremoteng/**" }
      ]
    }
  ]
}
