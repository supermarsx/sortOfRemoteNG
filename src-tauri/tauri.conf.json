{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sortOfRemoteNG",
  "version": "../package.json",
  "identifier": "com.sortofremote.ng",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev -- --fixed-tauri-port",
    "beforeBuildCommand": "npm run build && npm run stage:opkssh-vendor -- --release --enable"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sortOfRemoteNG",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "crates/sorng-opkssh-vendor/bundle/opkssh/": "opkssh/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "desktopTemplate": "packaging/linux.desktop",
        "files": {
          "/usr/share/icons/hicolor/32x32/apps/com.sortofremote.ng.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/com.sortofremote.ng.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.sortofremote.ng.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/com.sortofremote.ng.png": "icons/icon.png"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNDBGMTM2QTFFRUU2RDQKUldUVTV1NmhOdkZBTUpMeUFxYXNzMHdBRi9PemFUOUludnVYUHFpTTJVVXAyRGN4TUdJMmlhYjQK",
      "endpoints": [
        "https://github.com/supermarsx/sortOfRemoteNG/releases/latest/download/latest.json"
      ]
    }
  }
}
