      "passwordSelector": "form#form-login input#mod-login-password[name=\"passwd\"][type=\"password\"]",
      "submitSelector": "form#form-login button#btn-login-submit[type=\"submit\"], form#form-login button.login-button:not([type]), form#form-login button.login-button[type=\"submit\"]"
    }
  }
}
