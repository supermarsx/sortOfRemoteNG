# SSH test server
SSH_USER=testuser
SSH_PASSWORD=testpass

# VNC test server
VNC_PASSWORD=testpass

# MySQL test server
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=testuser
MYSQL_PASSWORD=testpass

# MariaDB test server (test-mariadb, host port 13307) reuses the MYSQL_* values.

# MongoDB test server (test-mongo, host port 27117; authSource=admin)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpass
MONGO_USER=testuser
MONGO_PASSWORD=testpass

# FTP test server
FTP_USER=testuser
FTP_PASSWORD=testpass

# SMB test server (docker/compose.e2e.yml)
SMB_HOST=127.0.0.1
SMB_PORT=1445
SMB_USER=sorngtest
SMB_PASSWORD=sorngpass
SMB_SHARE=public

# SoftEther test server (docker/compose.e2e.yml)
SOFTETHER_USER=testuser
SOFTETHER_PASSWORD=testpass123
SOFTETHER_ADMIN_PWD=test-admin-pwd-CHANGE-ME

# Portainer CE test server (test-portainer; >= 12 chars, written to
# e2e/.generated/portainer/admin_password by scripts/ci/e2e-portainer-fixture.mjs)
PORTAINER_URL=http://127.0.0.1:19000
PORTAINER_USER=admin
PORTAINER_ADMIN_PASSWORD=portainer-e2e-pass1234

# Nginx Proxy Manager test server (test-npm, host port 18181 = container 81).
# >= 8 chars and never "changeme": NPM forces a password change on the factory
# account, which scripts/ci/e2e-npm-fixture.mjs resolves for older image tags.
NPM_URL=http://127.0.0.1:18181
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=npm-e2e-pass1234
