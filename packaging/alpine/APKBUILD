# Contributor: sortOfRemoteNG contributors
# Maintainer: Mariana <17675589+supermarsx@users.noreply.github.com>

pkgname=sortofremoteng
pkgver=26.51.0
pkgrel=0
pkgdesc="Cross-platform remote connection manager"
url="https://github.com/supermarsx/sortOfRemoteNG"
arch="x86_64 aarch64"
license="MIT"
options="net ldpath-recursive"
depends="
	font-dejavu
	libayatana-appindicator
	librsvg
	libssh2
	openh264~2.6.0
	setserial
	sqlite-libs
	webkit2gtk-4.1
	"
makedepends="
	alsa-lib-dev
	build-base
	cargo
	clang-libclang
	cmake
	dbus-dev
	git
	gtk+3.0-dev
	librsvg-dev
	libsoup3-dev
	libssh2-dev
	nodejs
	npm
	openh264-dev
	openssl-dev
	perl
	pkgconf
	python3
	rust
	sqlite-dev
	webkit2gtk-4.1-dev
	"

_commit=72687ad1a5c751dbb1e4cf9e32134f4c3b210850
_release="${pkgver%.0}"
builddir="$srcdir/$pkgname"

_clone_exact() {
	local destination="$1" repository="$2" commit="$3"
	if [ ! -d "$destination/.git" ]; then
		git clone --filter=blob:none --no-checkout "$repository" "$destination"
	fi
	git -C "$destination" fetch --force --depth=1 origin "$commit"
	git -C "$destination" checkout --force --detach "$commit"
	test "$(git -C "$destination" rev-parse HEAD)" = "$commit"
}

fetch() {
	mkdir -p "$srcdir"
	_clone_exact "$builddir" "$url.git" "$_commit"
}

unpack() {
	fetch
}

prepare() {
	cd "$builddir"
	export CARGO_HOME="$srcdir/cargo"

	node scripts/sync-version.mjs --write --version "$_release"
	node scripts/sync-version.mjs --check
	npm ci --ignore-scripts --no-audit --no-fund

	local rust_target
	rust_target="$(rustc -vV | sed -n 's/^host: //p')"
	test -n "$rust_target"
	cargo fetch --locked --manifest-path src-tauri/Cargo.toml \
		--target "$rust_target"
}

build() {
	cd "$builddir"
	export CARGO_HOME="$srcdir/cargo"
	export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS="${CARGO_PROFILE_RELEASE_CODEGEN_UNITS:-16}"
	export CARGO_PROFILE_RELEASE_LTO="${CARGO_PROFILE_RELEASE_LTO:-off}"
	export CARGO_PROFILE_RELEASE_OPT_LEVEL="${CARGO_PROFILE_RELEASE_OPT_LEVEL:-1}"
	export CARGO_TARGET_DIR="$srcdir/target"
	export LIBSSH2_SYS_USE_PKG_CONFIG=1
	export OPENSSL_NO_VENDOR=1
	export OPENH264_LIB_DIR=/usr/lib

	npm run build
	npm run tauri -- build --ci --no-bundle \
		--config packaging/linux/tauri.distro.conf.json \
		--features full-linux-system -- --no-default-features --frozen
}

check() {
	local binary="$srcdir/target/release/com.sortofremote.ng"
	local library dynamic
	dynamic="$(readelf -d "$binary")"

	for library in \
		libopenh264.so.8 \
		libsqlite3.so.0 \
		libssh2.so.1
	do
		echo "$dynamic" | grep -Fq "Shared library: [$library]"
	done
}

package() {
	local resource_root="$pkgdir/usr/lib/sortOfRemoteNG"

	install -Dm755 "$srcdir/target/release/com.sortofremote.ng" \
		"$pkgdir/usr/bin/com.sortofremote.ng"
	install -dm755 "$resource_root"
	cp -a "$builddir/src/i18n/locales" "$resource_root/locales"

	install -Dm644 "$builddir/packaging/linux/com.sortofremote.ng.desktop" \
		"$pkgdir/usr/share/applications/com.sortofremote.ng.desktop"
	install -Dm644 \
		"$builddir/packaging/flatpak/com.sortofremote.ng.metainfo.xml" \
		"$pkgdir/usr/share/metainfo/com.sortofremote.ng.metainfo.xml"
	install -Dm644 "$builddir/src-tauri/icons/32x32.png" \
		"$pkgdir/usr/share/icons/hicolor/32x32/apps/com.sortofremote.ng.png"
	install -Dm644 "$builddir/src-tauri/icons/128x128.png" \
		"$pkgdir/usr/share/icons/hicolor/128x128/apps/com.sortofremote.ng.png"
	install -Dm644 "$builddir/src-tauri/icons/128x128@2x.png" \
		"$pkgdir/usr/share/icons/hicolor/256x256/apps/com.sortofremote.ng.png"
	install -Dm644 "$builddir/src-tauri/icons/icon.png" \
		"$pkgdir/usr/share/icons/hicolor/512x512/apps/com.sortofremote.ng.png"
	install -Dm644 "$builddir/license.md" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
