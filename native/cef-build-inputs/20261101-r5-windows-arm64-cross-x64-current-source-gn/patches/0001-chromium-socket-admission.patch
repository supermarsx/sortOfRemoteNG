+// No app policy cache: every socket/native verifier result reaches the browser
+// authority. Ref-counted by SSLClientContext; callbacks are sequence-confined.
+class SorngTlsAdmission final
+    : public net::SSLClientContext::TlsAdmissionDelegate,
+      public mojom::SorngTlsControl {
+ public:
+  SorngTlsAdmission(mojo::PendingRemote<mojom::SorngTlsClient> client,
+                    uint64_t generation)
+      : client_(std::move(client)), generation_(generation) {
+    client_.set_disconnect_handler(base::BindOnce(
+        &SorngTlsAdmission::FailClosed, weak_factory_.GetWeakPtr()));
+    client_->Ready(control_.BindNewPipeAndPassRemote());
+    control_.set_disconnect_handler(base::BindOnce(
+        &SorngTlsAdmission::FailClosed, weak_factory_.GetWeakPtr()));
+  }
+  bool IsActive() const override { return active_ && generation_ != 0; }
+  void AddSocket(const void* key, base::RepeatingClosure close) override {
+    sockets_.emplace(key, std::move(close));
+  }
+  void RemoveSocket(const void* key) override { sockets_.erase(key); }
+  void Verify(const net::HostPortPair& destination,
+              scoped_refptr<net::X509Certificate> peer_chain,
+              const net::CertVerifyResult& native_result, int native_error,
+              bool fatal, net::CompletionOnceCallback callback) override {
+    if (!IsActive() || pending_.size() >= 64 || !peer_chain ||
+        next_request_ == UINT64_MAX) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(callback),
+                                   net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    const uint64_t id = ++next_request_;
+    pending_.emplace(id, std::move(callback));
+    client_->Evaluate(generation_, destination.host(), destination.port(),
+                      peer_chain, native_result, native_error, fatal,
+                      base::BindOnce(&SorngTlsAdmission::OnDecision,
+                                     weak_factory_.GetWeakPtr(), id,
+                                     native_error, native_result.cert_status, fatal));
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&SorngTlsAdmission::OnDecision,
+                                 weak_factory_.GetWeakPtr(), id,
+                                 net::ERR_BLOCKED_BY_CLIENT, 0u, true, 0u, 0u),
+        base::Seconds(305));
+  }
+  void Revoke(uint64_t /*generation*/, RevokeCallback callback) override {
+    // Even a mismatched revoke can only remove authority, never create it.
+    FailClosed();
+    std::move(callback).Run();
+  }
+ private:
+  ~SorngTlsAdmission() override = default;
+  void OnDecision(uint64_t id, int native_error, uint32_t status, bool fatal,
+                  uint32_t decision, uint32_t exception_mask) {
+    auto it = pending_.find(id);
+    if (it == pending_.end()) return;
+    auto callback = std::move(it->second);
+    pending_.erase(it);
+    const bool admitted = sorng_tls::Admit(IsActive(), native_error, status, fatal,
+                                          decision, exception_mask);
+    // Browser answers, failures and timeouts all resume on the network sequence.
+    std::move(callback).Run(admitted ? net::OK : net::ERR_BLOCKED_BY_CLIENT);
+  }
+  void FailClosed() {
+    scoped_refptr<SorngTlsAdmission> keep_alive(this);
+    active_ = false;
+    auto pending = std::move(pending_);
+    pending_.clear();
+    for (auto& [id, callback] : pending)
+      std::move(callback).Run(net::ERR_BLOCKED_BY_CLIENT);
+    // Snapshot: closing a socket may remove itself or another socket.
+    const auto sockets = sockets_;
+    for (const auto& [key, close] : sockets) close.Run();
+  }
+  mojo::Remote<mojom::SorngTlsClient> client_;
+  mojo::Receiver<mojom::SorngTlsControl> control_{this};
+  const uint64_t generation_;
+  bool active_ = true;
+  uint64_t next_request_ = 0;
+  std::map<uint64_t, net::CompletionOnceCallback> pending_;
+  std::map<const void*, base::RepeatingClosure> sockets_;
+  base::WeakPtrFactory<SorngTlsAdmission> weak_factory_{this};
+};
 
