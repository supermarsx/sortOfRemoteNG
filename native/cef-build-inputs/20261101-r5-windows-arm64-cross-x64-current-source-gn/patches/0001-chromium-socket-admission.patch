+// The real socket/embedded TLS server exercise the bridge seam; these tests
+// must be built and run as net_unittests, not treated as patch-check evidence.
+class SorngTestAdmission final : public SSLClientContext::TlsAdmissionDelegate {
+ public:
+  bool IsActive() const override { return active; }
+  void AddSocket(const void* key, base::RepeatingClosure close) override {
+    sockets.emplace(key, std::move(close));
+  }
+  void RemoveSocket(const void* key) override { sockets.erase(key); }
+  void Verify(const HostPortPair& destination,
+              scoped_refptr<X509Certificate> peer_chain,
+              const CertVerifyResult& native_result, int native_error,
+              bool fatal, CompletionOnceCallback callback) override {
+    ++calls;
+    last_destination = destination;
+    last_error = native_error;
+    EXPECT_TRUE(peer_chain);
+    if (hold) {
+      held_callback = std::move(callback);
+      if (on_called) std::move(on_called).Run();
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback),
+            sorng_tls::Admit(active, native_error, native_result.cert_status, fatal,
+                            exception_mask ? 2u : (admit ? 1u : 0u), exception_mask)
+                ? OK : ERR_BLOCKED_BY_CLIENT));
+  }
+  void Revoke() {
+    active = false;
+    const auto copy = sockets;
+    for (const auto& [key, close] : copy) close.Run();
+  }
+  bool active = true;
+  bool admit = false;
+  bool hold = false;
+  uint32_t exception_mask = 0;
+  int calls = 0;
+  int last_error = ERR_FAILED;
+  HostPortPair last_destination;
+  CompletionOnceCallback held_callback;
+  base::OnceClosure on_called;
+  std::map<const void*, base::RepeatingClosure> sockets;
+ private:
+  ~SorngTestAdmission() override = default;
+};
+class SorngTlsSocketTest : public SSLClientSocketTest,
+                           public testing::WithParamInterface<bool> {};
+INSTANTIATE_TEST_SUITE_P(NativeVerifierSyncAndAsync, SorngTlsSocketTest, Bool());
+
+TEST_P(SorngTlsSocketTest, CaValidDenialStillBlocksConnectWithExactPort) {
+  ASSERT_TRUE(StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, SSLServerConfig()));
+  cert_verifier_->set_async(GetParam());
+  auto gate = base::MakeRefCounted<SorngTestAdmission>();
+  context_->SetTlsAdmissionDelegate(gate);
+  int result;
+  ASSERT_TRUE(CreateAndConnectSSLClientSocket(SSLConfig(), &result));
+  EXPECT_EQ(ERR_BLOCKED_BY_CLIENT, result);
+  EXPECT_EQ(1, gate->calls);
+  EXPECT_EQ(OK, gate->last_error);
+  EXPECT_EQ(host_port_pair(), gate->last_destination);
+  EXPECT_FALSE(sock_->IsConnected());
+}
+
+TEST_P(SorngTlsSocketTest, NativeErrorIsDeliveredNotReplacedByAppAllow) {
+  ASSERT_TRUE(StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, SSLServerConfig()));
+  cert_verifier_->set_async(GetParam());
+  cert_verifier_->set_default_result(ERR_CERT_DATE_INVALID);
+  auto gate = base::MakeRefCounted<SorngTestAdmission>();
+  gate->admit = true;
+  context_->SetTlsAdmissionDelegate(gate);
+  int result;
+  ASSERT_TRUE(CreateAndConnectSSLClientSocket(SSLConfig(), &result));
+  EXPECT_EQ(ERR_BLOCKED_BY_CLIENT, result);
+  EXPECT_EQ(1, gate->calls);
+  EXPECT_EQ(ERR_CERT_DATE_INVALID, gate->last_error);
+}
+
+TEST_P(SorngTlsSocketTest, EveryConnectionIsAdmittedWithoutEarlyDataOrH2) {
+  SSLServerConfig server;
+  server.alpn_protos = {NextProto::kProtoHTTP2, NextProto::kProtoHTTP11};
+  ASSERT_TRUE(StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, server));
+  cert_verifier_->set_async(GetParam());
+  auto gate = base::MakeRefCounted<SorngTestAdmission>();
+  gate->admit = true;
+  context_->SetTlsAdmissionDelegate(gate);
+  SSLConfig config;
+  config.early_data_enabled = true;
+  config.alpn_protos = server.alpn_protos;
+  for (int i = 0; i < 2; ++i) {
+    int result;
+    ASSERT_TRUE(CreateAndConnectSSLClientSocket(config, &result));
+    ASSERT_EQ(OK, result);
+    EXPECT_EQ(NextProto::kProtoHTTP11, sock_->GetNegotiatedProtocol());
+    SSLInfo info;
+    ASSERT_TRUE(sock_->GetSSLInfo(&info));
+    EXPECT_EQ(SSLInfo::HANDSHAKE_FULL, info.handshake_type);
+    EXPECT_FALSE(info.early_data_accepted);
+    sock_.reset();
+  }
+  EXPECT_EQ(2, gate->calls);
+}
+
+TEST_P(SorngTlsSocketTest, RevokeDisconnectsAdmittedSocket) {
+  ASSERT_TRUE(StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, SSLServerConfig()));
+  cert_verifier_->set_async(GetParam());
+  auto gate = base::MakeRefCounted<SorngTestAdmission>();
+  gate->admit = true;
+  context_->SetTlsAdmissionDelegate(gate);
+  int result;
+  ASSERT_TRUE(CreateAndConnectSSLClientSocket(SSLConfig(), &result));
+  ASSERT_EQ(OK, result);
+  gate->Revoke();
+  EXPECT_FALSE(sock_->IsConnected());
+  auto bytes = base::MakeRefCounted<StringIOBuffer>("POST / HTTP/1.1\r\n\r\n");
+  TestCompletionCallback callback;
+  EXPECT_EQ(ERR_BLOCKED_BY_CLIENT, sock_->Write(
+      bytes.get(), bytes->size(), callback.callback(), TRAFFIC_ANNOTATION_FOR_TESTS));
+  sock_.reset();
+  EXPECT_TRUE(gate->sockets.empty());
+}
+
+TEST_P(SorngTlsSocketTest, ScopedSelfSignedExceptionPreservesNativeStatus) {
+  ASSERT_TRUE(StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, SSLServerConfig()));
+  cert_verifier_->set_async(GetParam());
+  CertVerifyResult verification;
+  verification.verified_cert = embedded_test_server()->GetCertificate();
+  verification.cert_status = CERT_STATUS_AUTHORITY_INVALID;
+  cert_verifier_->AddResultForCert(verification.verified_cert.get(), verification,
+                                  ERR_CERT_AUTHORITY_INVALID);
+  auto gate = base::MakeRefCounted<SorngTestAdmission>();
+  gate->exception_mask = 4;
+  context_->SetTlsAdmissionDelegate(gate);
+  int result;
+  ASSERT_TRUE(CreateAndConnectSSLClientSocket(SSLConfig(), &result));
+  ASSERT_EQ(OK, result);
+  EXPECT_EQ(ERR_CERT_AUTHORITY_INVALID, gate->last_error);
+  SSLInfo info;
+  ASSERT_TRUE(sock_->GetSSLInfo(&info));
+  EXPECT_EQ(CERT_STATUS_AUTHORITY_INVALID, info.cert_status);
+  sock_.reset();
+  gate->exception_mask = 1;  // Wrong exception cannot reuse the previous permit.
+  ASSERT_TRUE(CreateAndConnectSSLClientSocket(SSLConfig(), &result));
+  EXPECT_EQ(ERR_BLOCKED_BY_CLIENT, result);
+}
+
+TEST_P(SorngTlsSocketTest, DestroyPendingSocketDiscardsLateAdmission) {
+  ASSERT_TRUE(StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, SSLServerConfig()));
+  cert_verifier_->set_async(GetParam());
+  auto gate = base::MakeRefCounted<SorngTestAdmission>();
+  gate->hold = true;
+  base::RunLoop requested;
+  gate->on_called = requested.QuitClosure();
+  context_->SetTlsAdmissionDelegate(gate);
+  TestCompletionCallback transport_done;
+  auto transport = std::make_unique<TCPClientSocket>(
+      addr(), nullptr, nullptr, NetLog::Get(), NetLogSource(),
+      handles::kInvalidNetworkHandle);
+  ASSERT_EQ(OK, transport_done.GetResult(transport->Connect(transport_done.callback())));
+  auto socket = CreateSSLClientSocket(std::move(transport), host_port_pair(), SSLConfig());
+  TestCompletionCallback connected;
+  ASSERT_EQ(ERR_IO_PENDING, socket->Connect(connected.callback()));
+  requested.Run();
+  ASSERT_TRUE(gate->held_callback);
+  EXPECT_FALSE(connected.have_result());
+  socket.reset();
+  EXPECT_TRUE(gate->sockets.empty());
+  std::move(gate->held_callback).Run(OK);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(connected.have_result());
+}
