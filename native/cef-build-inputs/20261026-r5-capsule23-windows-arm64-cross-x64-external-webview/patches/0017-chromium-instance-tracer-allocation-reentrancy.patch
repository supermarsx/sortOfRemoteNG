--- /dev/null
+++ b/base/allocator/partition_allocator/src/partition_alloc/pointers/instance_tracer_storage.h
@@ -0,0 +1,107 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef PARTITION_ALLOC_POINTERS_INSTANCE_TRACER_STORAGE_H_
+#define PARTITION_ALLOC_POINTERS_INSTANCE_TRACER_STORAGE_H_
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace base::internal {
+
+// Private implementation shared with allocation/lock-order regressions. The
+// production instantiation uses the standard mutex and standard allocators.
+template <typename Info,
+          typename Mutex = std::mutex,
+          typename NodeAllocator =
+              std::allocator<std::pair<const uint64_t, Info>>,
+          typename StackAllocator = std::allocator<std::array<const void*, 32>>>
+class InstanceTracerStorage {
+ public:
+  using StackTrace = std::array<const void*, 32>;
+  using Stacks = std::vector<StackTrace, StackAllocator>;
+
+  template <typename... Args>
+  void Trace(uint64_t owner_id, Args&&... args) {
+    // Both allocation and Info construction (including stack collection) can
+    // reenter tracing through allocator hooks. Prepare the node without the
+    // storage mutex, then transfer ownership without allocating under it.
+    Storage pending;
+    pending.try_emplace(owner_id, std::forward<Args>(args)...);
+    auto unused = InsertPrepared(pending.extract(owner_id));
+    // A duplicate retains the original Info. Its unused prepared node is
+    // destroyed here, after InsertPrepared has released the storage mutex.
+    (void)unused;
+  }
+
+  void Untrace(uint64_t owner_id) {
+    // Preserve the existing extract fix: node deallocation can reenter tracing,
+    // so detach under the mutex and destroy only after it has been released.
+    auto removed = [&] {
+      const std::lock_guard guard(mutex_);
+      return storage_.extract(owner_id);
+    }();
+  }
+
+  Stacks GetStackTracesForAllocation(uintptr_t allocation) {
+    Stacks result;
+    const std::size_t maximum = result.max_size();
+    for (;;) {
+      std::size_t needed = 0;
+      {
+        const std::lock_guard guard(mutex_);
+        for (const auto& [id, info] : storage_) {
+          if (info.slot_count == allocation && !info.may_dangle) {
+            ++needed;
+          }
+        }
+        if (needed <= result.capacity()) {
+          // The result remains empty until one complete copy fits. Counting
+          // and copying under this same lock give a linearized snapshot in
+          // owner-key order, without any heap work or partial/truncated data.
+          for (const auto& [id, info] : storage_) {
+            if (info.slot_count == allocation && !info.may_dangle) {
+              result.push_back(info.stack_trace);
+            }
+          }
+          break;
+        }
+      }
+      // Concurrent additions may require another pass. Grow geometrically so
+      // small additions cannot force repeated exact-sized reallocations. The
+      // only bound is the vector's existing representable maximum, not a cap
+      // on the number of returned traces; reserve retains its failure policy.
+      const std::size_t capacity = result.capacity();
+      const std::size_t grown = capacity > maximum / 2
+                                    ? maximum
+                                    : std::max<std::size_t>(1, capacity * 2);
+      result.reserve(std::max(needed, grown));
+    }
+    return result;
+  }
+
+ private:
+  using Storage = std::map<uint64_t, Info, std::less<uint64_t>, NodeAllocator>;
+  static_assert(std::allocator_traits<NodeAllocator>::is_always_equal::value,
+                "Prepared map nodes must use interchangeable allocators");
+
+  typename Storage::node_type InsertPrepared(typename Storage::node_type node) {
+    const std::lock_guard guard(mutex_);
+    return storage_.insert(std::move(node)).node;
+  }
+
+  Mutex mutex_;
+  Storage storage_;
+};
+
+}  // namespace base::internal
+
+#endif  // PARTITION_ALLOC_POINTERS_INSTANCE_TRACER_STORAGE_H_
