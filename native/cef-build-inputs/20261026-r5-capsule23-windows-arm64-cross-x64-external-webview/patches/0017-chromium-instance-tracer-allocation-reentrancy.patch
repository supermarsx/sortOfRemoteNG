+  BrpAllocation owned(8);
+  EXPECT_TRUE(
+      InstanceTracer::GetStackTracesForAddressForTest(owned.get()).empty());
+  {
+    base::raw_ptr<int> first = owned.get();
+    const auto one =
+        InstanceTracer::GetStackTracesForAddressForTest(owned.get());
+    EXPECT_EQ(one.size(), 1u);
+    {
+      base::raw_ptr<int> second = first;
+      EXPECT_EQ(
+          InstanceTracer::GetStackTracesForAddressForTest(owned.get()).size(),
+          2u);
+    }
+    EXPECT_EQ(InstanceTracer::GetStackTracesForAddressForTest(owned.get()),
