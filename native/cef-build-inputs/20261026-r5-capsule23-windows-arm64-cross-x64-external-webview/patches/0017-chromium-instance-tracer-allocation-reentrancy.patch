--- /dev/null
+++ b/base/allocator/partition_allocator/src/partition_alloc/pointers/instance_tracer_storage_unittest.cc
@@ -0,0 +1,431 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "partition_alloc/pointers/instance_tracer_storage.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <new>
+#include <thread>
+
+#if defined(SORNG_INSTANCE_TRACER_STORAGE_STANDALONE)
+#include <iostream>
+#include <string_view>
+namespace {
+struct TestCase {
+  const char* name;
+  void (*run)();
+};
+auto& Cases() {
+  static std::vector<TestCase> cases;
+  return cases;
+}
+std::atomic<int> failures{0};
+struct Register {
+  Register(const char* name, void (*run)()) { Cases().push_back({name, run}); }
+};
+void Expect(bool passed, const char* expression, int line) {
+  if (!passed) {
+    ++failures;
+    std::cerr << "FAIL " << line << ": " << expression << '\n';
+  }
+}
+}  // namespace
+#define TEST(suite, name)                                 \
+  void suite##_##name();                                  \
+  static Register register_##name(#name, suite##_##name); \
+  void suite##_##name()
+#define EXPECT_TRUE(value) Expect(!!(value), #value, __LINE__)
+#define EXPECT_EQ(left, right) \
+  Expect((left) == (right), #left " == " #right, __LINE__)
+#else
+#include "partition_alloc/partition_alloc_for_testing.h"
+#include "partition_alloc/pointers/instance_tracer.h"
+#include "partition_alloc/pointers/raw_ptr.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#endif
+
+namespace base::internal {
+namespace {
+thread_local unsigned held_mutexes = 0;
+thread_local bool in_allocator_hook = false;
+std::atomic<unsigned> locked_allocations{0};
+std::atomic<unsigned> locked_deallocations{0};
+std::atomic<unsigned> allocations{0};
+struct Callback {
+  template <typename F>
+  static Callback From(F& function) {
+    return {&function, [](void* context) { (*static_cast<F*>(context))(); }};
+  }
+  explicit operator bool() const { return invoke != nullptr; }
+  void operator()() const { invoke(context); }
+  void* context = nullptr;
+  void (*invoke)(void*) = nullptr;
+};
+Callback allocation_hook;
+Callback construction_hook;
+std::atomic<unsigned> locked_constructions{0};
+std::atomic<unsigned> locked_destructions{0};
+
+// Test-only BasicLockable: observe the same critical section boundaries without
+// pretending a wrapper transfers ownership of libc++'s separately annotated
+// std::mutex member. The production instantiation remains std::mutex.
+struct ObservedMutex {
+  void lock() {
+    while (held.test_and_set(std::memory_order_acquire)) {
+      std::this_thread::yield();
+    }
+    ++held_mutexes;
+  }
+  void unlock() {
+    --held_mutexes;
+    held.clear(std::memory_order_release);
+  }
+  std::atomic_flag held = ATOMIC_FLAG_INIT;
+};
+
+template <typename T>
+struct ObservedAllocator {
+  using value_type = T;
+  using is_always_equal = std::true_type;
+  ObservedAllocator() = default;
+  template <typename U>
+  ObservedAllocator(const ObservedAllocator<U>&) {}
+  T* allocate(size_t count) {
+    ++allocations;
+    if (held_mutexes)
+      ++locked_allocations;
+    if (!held_mutexes && !in_allocator_hook && allocation_hook) {
+      in_allocator_hook = true;
+      allocation_hook();
+      in_allocator_hook = false;
+    }
+    return std::allocator<T>().allocate(count);
+  }
+  void deallocate(T* pointer, size_t count) {
+    if (held_mutexes)
+      ++locked_deallocations;
+    std::allocator<T>().deallocate(pointer, count);
+  }
+  template <typename U>
+  bool operator==(const ObservedAllocator<U>&) const {
+    return true;
+  }
+};
+
+struct TestInfo {
+  TestInfo(uintptr_t slot, bool dangling, uintptr_t marker)
+      : slot_count(slot), may_dangle(dangling) {
+    if (held_mutexes)
+      ++locked_constructions;
+    else if (construction_hook)
+      construction_hook();
+    stack_trace[0] = reinterpret_cast<const void*>(marker);
+    stack_trace[1] = reinterpret_cast<const void*>(slot);
+  }
+  ~TestInfo() {
+    if (held_mutexes)
+      ++locked_destructions;
+  }
+  uintptr_t slot_count;
+  bool may_dangle;
+  std::array<const void*, 32> stack_trace{};
+};
+using Storage = InstanceTracerStorage<
+    TestInfo,
+    ObservedMutex,
+    ObservedAllocator<std::pair<const uint64_t, TestInfo>>,
+    ObservedAllocator<std::array<const void*, 32>>>;
+void Reset() {
+  allocation_hook = {};
+  construction_hook = {};
+  locked_constructions = 0;
+  locked_destructions = 0;
+  locked_allocations = 0;
+  locked_deallocations = 0;
+  allocations = 0;
+  EXPECT_EQ(held_mutexes, 0u);
+}
+uintptr_t Marker(const Storage::StackTrace& trace) {
+  return reinterpret_cast<uintptr_t>(trace[0]);
+}
+
+TEST(InstanceTracerStorageTest,
+     TraceAllocationAndRemovalNeverHoldStorageMutex) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 11);
+  EXPECT_EQ(locked_allocations.load(), 0u);
+  storage.Untrace(1);
+  storage.Untrace(1);
+  EXPECT_EQ(locked_deallocations.load(), 0u);
+  EXPECT_EQ(locked_constructions.load(), 0u);
+  EXPECT_EQ(locked_destructions.load(), 0u);
+}
+
+TEST(InstanceTracerStorageTest, SnapshotAllocationNeverHoldsStorageMutex) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 11);
+  locked_allocations = 0;
+  auto traces = storage.GetStackTracesForAllocation(7);
+  EXPECT_EQ(traces.size(), 1u);
+  EXPECT_EQ(locked_allocations.load(), 0u);
+  storage.Untrace(1);
+}
+
+TEST(InstanceTracerStorageTest,
+     DuplicatePreservesOriginalAndDestroysUnusedNodeOutsideMutex) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 11);
+  storage.Trace(1, 8, true, 22);
+  auto traces = storage.GetStackTracesForAllocation(7);
+  EXPECT_EQ(traces.size(), 1u);
+  if (!traces.empty())
+    EXPECT_EQ(Marker(traces[0]), 11u);
+  EXPECT_TRUE(storage.GetStackTracesForAllocation(8).empty());
+  storage.Untrace(1);
+  EXPECT_EQ(locked_allocations.load(), 0u);
+  EXPECT_EQ(locked_deallocations.load(), 0u);
+}
+
+TEST(InstanceTracerStorageTest,
+     SnapshotIsCompleteSortedAndFiltersSlotAndMayDangle) {
+  Reset();
+  Storage storage;
+  storage.Trace(30, 7, false, 30);
+  storage.Trace(10, 7, false, 10);
+  storage.Trace(20, 7, true, 20);
+  storage.Trace(40, 8, false, 40);
+  const auto traces = storage.GetStackTracesForAllocation(7);
+  EXPECT_EQ(traces.size(), 2u);
+  if (traces.size() == 2) {
+    EXPECT_EQ(Marker(traces[0]), 10u);
+    EXPECT_EQ(Marker(traces[1]), 30u);
+  }
+  storage.Untrace(10);
+  EXPECT_EQ(traces.size(),
+            2u);  // The returned snapshot owns its complete copy.
+  storage.Untrace(20);
+  storage.Untrace(30);
+  storage.Untrace(40);
+  EXPECT_TRUE(storage.GetStackTracesForAllocation(7).empty());
+}
+
+TEST(InstanceTracerStorageTest, NodeAllocatorCanReenterRemovalBeforeInsertion) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 11);
+  bool called = false;
+  auto hook = [&] {
+    called = true;
+    storage.Untrace(1);
+  };
+  allocation_hook = Callback::From(hook);
+  storage.Trace(2, 7, false, 22);
+  allocation_hook = {};
+  EXPECT_TRUE(called);
+  const auto traces = storage.GetStackTracesForAllocation(7);
+  EXPECT_EQ(traces.size(), 1u);
+  if (!traces.empty())
+    EXPECT_EQ(Marker(traces[0]), 22u);
+  storage.Untrace(2);
+  EXPECT_EQ(locked_deallocations.load(), 0u);
+}
+
+TEST(InstanceTracerStorageTest,
+     SnapshotRetriesAfterCapacityAllocationAddsOwners) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 1);
+  bool injected = false;
+  auto hook = [&] {
+    if (injected)
+      return;
+    injected = true;
+    for (uint64_t id = 2; id <= 17; ++id)
+      storage.Trace(id, 7, false, id);
+  };
+  allocation_hook = Callback::From(hook);
+  const auto traces = storage.GetStackTracesForAllocation(7);
+  allocation_hook = {};
+  EXPECT_TRUE(injected);
+  EXPECT_EQ(traces.size(), 17u);
+  for (size_t i = 0; i < traces.size(); ++i)
+    EXPECT_EQ(Marker(traces[i]), i + 1);
+  for (uint64_t id = 1; id <= 17; ++id)
+    storage.Untrace(id);
+  EXPECT_EQ(locked_allocations.load(), 0u);
+  EXPECT_EQ(locked_deallocations.load(), 0u);
+}
+
+TEST(InstanceTracerStorageTest, InfoConstructionCanReenterRemoval) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 11);
+  bool called = false;
+  auto hook = [&] {
+    called = true;
+    storage.Untrace(1);
+  };
+  construction_hook = Callback::From(hook);
+  storage.Trace(2, 7, false, 22);
+  construction_hook = {};
+  EXPECT_TRUE(called);
+  const auto traces = storage.GetStackTracesForAllocation(7);
+  EXPECT_EQ(traces.size(), 1u);
+  if (!traces.empty())
+    EXPECT_EQ(Marker(traces[0]), 22u);
+  storage.Untrace(2);
+  EXPECT_EQ(locked_constructions.load(), 0u);
+  EXPECT_EQ(locked_destructions.load(), 0u);
+}
+
+TEST(InstanceTracerStorageTest,
+     GeometricCapacityProgressesDuringReserveTimeGrowth) {
+  Reset();
+  Storage storage;
+  storage.Trace(1, 7, false, 1);
+  unsigned reserves = 0;
+  auto hook = [&] {
+    if (++reserves <= 17)
+      storage.Trace(reserves + 1, 7, false, reserves + 1);
+  };
+  allocation_hook = Callback::From(hook);
+  const auto traces = storage.GetStackTracesForAllocation(7);
+  allocation_hook = {};
+  EXPECT_TRUE(reserves > 0 && reserves <= 4);
+  EXPECT_EQ(traces.size(), reserves + 1);
+  for (size_t i = 0; i < traces.size(); ++i)
+    EXPECT_EQ(Marker(traces[i]), i + 1);
+  for (uint64_t id = 1; id <= reserves + 1; ++id)
+    storage.Untrace(id);
+  EXPECT_EQ(locked_allocations.load(), 0u);
+  EXPECT_EQ(locked_deallocations.load(), 0u);
+}
+
+TEST(InstanceTracerStorageTest, FourConcurrentWritersAndSnapshotsFinishEmpty) {
+  Reset();
+  Storage storage;
+  std::atomic<bool> bad_snapshot{false};
+  std::array<std::thread, 4> threads;
+  for (size_t worker = 0; worker < threads.size(); ++worker) {
+    threads[worker] = std::thread([&, worker] {
+      for (uint64_t iteration = 1; iteration <= 256; ++iteration) {
+        const uint64_t id = 1 + worker * 256 + iteration;
+        storage.Trace(id, 7, false, id);
+        const auto traces = storage.GetStackTracesForAllocation(7);
+        uintptr_t previous = 0;
+        for (const auto& trace : traces) {
+          if (Marker(trace) <= previous ||
+              reinterpret_cast<uintptr_t>(trace[1]) != 7)
+            bad_snapshot = true;
+          previous = Marker(trace);
+        }
+        storage.Untrace(id);
+      }
+    });
+  }
+  for (auto& thread : threads)
+    thread.join();
+  EXPECT_TRUE(!bad_snapshot.load());
+  EXPECT_TRUE(storage.GetStackTracesForAllocation(7).empty());
+  EXPECT_EQ(locked_allocations.load(), 0u);
+  EXPECT_EQ(locked_deallocations.load(), 0u);
+}
+
+#if !defined(SORNG_INSTANCE_TRACER_STORAGE_STANDALONE)
+#if PA_BUILDFLAG(ENABLE_BACKUP_REF_PTR_INSTANCE_TRACER) && \
+    PA_BUILDFLAG(USE_RAW_PTR_BACKUP_REF_IMPL)
+// Explicit BRP-enabled allocations make these real raw_ptr tests independent
+// of whether the test executable's global new uses the allocator shim.
+class BrpAllocation {
+ public:
+  explicit BrpAllocation(int value)
+      : allocator_([] {
+          partition_alloc::PartitionOptions options;
+          options.backup_ref_ptr = partition_alloc::PartitionOptions::kEnabled;
+          return options;
+        }()) {
+    partition_alloc::PartitionAllocGlobalInit([](size_t) { std::abort(); });
+    value_ =
+        ::new (allocator_.root()->Alloc(sizeof(int), "tracer-test")) int(value);
+  }
+  ~BrpAllocation() { allocator_.root()->Free(value_); }
+  int* get() const { return value_; }
+
+ private:
+  partition_alloc::PartitionAllocatorForTesting allocator_;
+  int* value_;
+};
