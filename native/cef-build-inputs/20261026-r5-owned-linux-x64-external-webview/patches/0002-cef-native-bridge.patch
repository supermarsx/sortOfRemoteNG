@@ -0,0 +1,30 @@
+// Copyright 2026 The sorng Authors. BSD-3-Clause.
+#define SORNG_TLS_IMPLEMENTATION
+#include "cef/include/cef_sorng_tls_bridge.h"
+#include "cef/libcef/browser/net_service/sorng_tls_bridge.h"
+#include "cef/libcef_dll/cpptoc/request_context_cpptoc.h"
+#include "cef/libcef_dll/ctocpp/request_context_handler_ctocpp.h"
+
+extern "C" struct _cef_request_context_t* SORNG_TLS_CALL
+cef_sorng_tls_create_context_v2(
+    const cef_sorng_tls_context_v2* config,
+    const cef_request_context_settings_t* settings,
+    struct _cef_request_context_handler_t* handler) {
+  // The public bridge retains CEF's opaque client ABI. DLL-side generated
+  // wrappers use versioned C structures and dispatch helpers.
+  auto* handler_v0 = reinterpret_cast<cef_request_context_handler_0_t*>(handler);
+  if (!settings || settings->size != sizeof(*settings) ||
+      (handler_v0 && (handler_v0->base.size != sizeof(*handler_v0) ||
+                      !handler_v0->base.add_ref || !handler_v0->base.release)))
+    return nullptr;
+  CefRequestContextSettings copied;
+  copied.Set(*settings, true);
+  // This additional ABI BORROWS the caller reference. CToCpp::Wrap consumes
+  // one transferred reference, so create that reference explicitly first.
+  if (handler_v0) handler_v0->base.add_ref(&handler_v0->base);
+  auto wrapped_handler = CefRequestContextHandlerCToCpp_Wrap(handler_v0);
+  auto context = CefSorngCreateContext(config, copied, wrapped_handler);
+  return context ? reinterpret_cast<struct _cef_request_context_t*>(
+                       CefRequestContextCppToC_Wrap(context))
+                 : nullptr;
+}
