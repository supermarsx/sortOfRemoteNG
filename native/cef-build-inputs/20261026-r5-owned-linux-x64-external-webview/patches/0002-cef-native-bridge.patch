diff --git a/libcef/browser/net_service/sorng_tls_bridge.cc b/libcef/browser/net_service/sorng_tls_bridge.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2a6f038d0a86c4d53266838c4bcfd1e1b541e7cc
--- /dev/null
+++ b/libcef/browser/net_service/sorng_tls_bridge.cc
@@ -0,0 +1,345 @@
+// Copyright 2026 The sorng Authors. BSD-3-Clause.
+#include "cef/libcef/browser/net_service/sorng_tls_bridge.h"
+#include "cef/libcef/browser/browser_context.h"
+#include "cef/libcef/browser/request_context_impl.h"
+#define SORNG_TLS_IMPLEMENTATION
+#include "cef/include/cef_sorng_tls_bridge.h"
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "content/public/browser/browser_thread.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "net/cert/cert_verify_result.h"
+#include "net/cert/x509_certificate.h"
+#include "net/socket/sorng_tls_policy.h"
+#include "net/net_buildflags.h"
+#include "services/network/public/mojom/cert_verifier_service_updater.mojom.h"
+#include "net/cert/x509_util.h"
+#include "third_party/boringssl/src/pki/parsed_certificate.h"
+#include "third_party/boringssl/src/include/openssl/pool.h"
+
+namespace {
+constexpr uint32_t kReady = 1, kRevoked = 2, kFault = 3;
+bool OnUi() {
+  return content::BrowserThread::CurrentlyOn(content::BrowserThread::UI);
+}
+bool ValidChain(const net::X509Certificate* cert) {
+  if (!cert || cert->intermediate_buffers().size() > 31)
+    return false;
+  if (CRYPTO_BUFFER_len(cert->cert_buffer()) == 0 ||
+      CRYPTO_BUFFER_len(cert->cert_buffer()) > 256 * 1024)
+    return false;
+  for (const auto& item : cert->intermediate_buffers()) {
+    if (CRYPTO_BUFFER_len(item.get()) == 0 ||
+        CRYPTO_BUFFER_len(item.get()) > 256 * 1024)
+      return false;
+  }
+  return true;
+}
+std::vector<cef_sorng_tls_bytes_v2> Chain(const net::X509Certificate* cert) {
+  std::vector<cef_sorng_tls_bytes_v2> result;
+  if (!cert)
+    return result;
+  result.push_back({CRYPTO_BUFFER_data(cert->cert_buffer()),
+                    CRYPTO_BUFFER_len(cert->cert_buffer())});
+  for (const auto& item : cert->intermediate_buffers())
+    result.push_back(
+        {CRYPTO_BUFFER_data(item.get()), CRYPTO_BUFFER_len(item.get())});
+  return result;
+}
+
+class Registration final : public network::mojom::SorngTlsClient {
+ public:
+  explicit Registration(const cef_sorng_tls_context_v2& input,
+                        std::vector<std::vector<uint8_t>> roots)
+      : input_(input), roots_(std::move(roots)) {
+    // Do not retain a borrowed caller pointer.
+    input_.trust_anchors = nullptr;
+    receivers_.set_disconnect_handler(
+        base::BindRepeating(&Registration::Fail, weak_factory_.GetWeakPtr()));
+  }
+  void Attach(CefBrowserContext* context) { CHECK(!context_); context_ = context; }
+  bool Matches(CefBrowserContext* context) const { return context && context_ == context; }
+  void Detach() { context_ = nullptr; Revoke(); }
+  void Abandon() { terminal_reported_ = true; Revoke(); }
+  void ConfigureRoots(cert_verifier::mojom::CertVerifierCreationParams* params) {
+    params->sorng_ca_mode = input_.ca_mode;
+    if (input_.ca_mode != CEF_SORNG_TLS_CA_SYSTEM) {
+      auto certificates = cert_verifier::mojom::AdditionalCertificates::New();
+      certificates->trust_anchors_with_enforced_constraints = roots_;
+      certificates->include_system_trust_store =
+          input_.ca_mode == CEF_SORNG_TLS_CA_SYSTEM_PLUS_CUSTOM;
+      params->initial_additional_certificates = std::move(certificates);
+      // Initialization is complete in the creation message, not a later prefs
+      // update. Custom CA configuration is immutable in CertVerifierService.
+      params->wait_for_update = false;
+    }
+  }
+  uint64_t generation() const { return input_.generation; }
+  mojo::PendingRemote<network::mojom::SorngTlsClient> Bind() {
+    mojo::PendingRemote<network::mojom::SorngTlsClient> remote;
+    receivers_.Add(this, remote.InitWithNewPipeAndPassReceiver());
+    return remote;
+  }
+  void Ready(
+      mojo::PendingRemote<network::mojom::SorngTlsControl> control) override {
+    if (controls_.size() >= 64) {
+      Fail();
+      return;
+    }
+    // A context may create more than one storage partition. Every partition
+    // receives its own immutable delegate and control endpoint.
+    auto endpoint =
+        std::make_unique<mojo::Remote<network::mojom::SorngTlsControl>>(
+            std::move(control));
+    endpoint->set_disconnect_handler(
+        base::BindOnce(&Registration::Fail, weak_factory_.GetWeakPtr()));
+    controls_.push_back(std::move(endpoint));
+    if (revoked_) {
+      controls_.back()->get()->Revoke(input_.generation, base::DoNothing());
+      return;
+    }
+    Report(kReady);
+  }
+  void Evaluate(uint64_t generation,
+                const std::string& hostname,
+                uint16_t port,
+                const scoped_refptr<net::X509Certificate>& peer_chain,
+                const net::CertVerifyResult& native_result,
+                int32_t native_error,
+                bool fatal,
+                EvaluateCallback callback) override {
+    if (revoked_ || generation != input_.generation || port == 0 ||
+        hostname.empty() || hostname.size() > 253 ||
+        !base::IsStringASCII(hostname) || !ValidChain(peer_chain.get()) ||
+        (native_result.verified_cert &&
+         !ValidChain(native_result.verified_cert.get())) ||
+        pending_.size() >= 64 || next_challenge_ == UINT64_MAX) {
+      std::move(callback).Run(0, 0);
+      return;
+    }
+    const uint64_t challenge = ++next_challenge_;
+    const uint32_t mask = sorng_tls::ExceptionMask(native_error, native_result.cert_status, fatal);
+    pending_.emplace(challenge, Pending{std::move(callback), native_error,
+                                       native_result.cert_status, fatal});
+    auto peer = Chain(peer_chain.get());
+    auto verified = Chain(native_result.verified_cert.get());
+    cef_sorng_tls_evidence_v2 evidence{};
+    evidence.size = sizeof(evidence);
+    evidence.abi_version = CEF_SORNG_TLS_ABI_V2;
+    evidence.context_token = input_.context_token;
+    evidence.generation = generation;
+    evidence.challenge = challenge;
+    evidence.hostname = {reinterpret_cast<const uint8_t*>(hostname.data()),
+                         hostname.size()};
+    evidence.port = port;
+    evidence.native_error = native_error;
+    evidence.certificate_status = native_result.cert_status;
+    evidence.fatal_error = fatal;
+    evidence.issued_by_known_root = native_result.is_issued_by_known_root;
+    evidence.peer_chain = peer.data();
+    evidence.peer_chain_count = peer.size();
+    evidence.verified_chain = verified.data();
+    evidence.verified_chain_count = verified.size();
+    evidence.ca_mode = input_.ca_mode;
+    evidence.allowed_exception_mask = mask;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&Registration::Expire, weak_factory_.GetWeakPtr(),
+                       challenge),
+        base::Seconds(300));
+    input_.on_evidence(input_.user_data, &evidence);
+  }
+  bool Complete(uint64_t challenge, uint32_t decision, uint32_t mask) {
+    auto it = pending_.find(challenge);
+    if (revoked_ || decision > 2 || it == pending_.end())
+      return false;
+    if (decision != 0 && !sorng_tls::Admit(true, it->second.error,
+            it->second.status, it->second.fatal, decision, mask)) return false;
+    if (decision == 0 && mask != 0) return false;
+    auto callback = std::move(it->second.callback);
+    pending_.erase(it);
+    std::move(callback).Run(decision, mask);
+    return true;
+  }
+  void Revoke() {
+    if (revoked_)
+      return;
+    revoked_ = true;
+    auto pending = std::move(pending_);
+    pending_.clear();
+    for (auto& [id, pending_item] : pending)
+      std::move(pending_item.callback).Run(0, 0);
+    remaining_revokes_ = controls_.size();
+    if (remaining_revokes_ == 0) {
+      Report(kRevoked);
+      return;
+    }
+    for (const auto& control : controls_)
+      control->get()->Revoke(
+          input_.generation,
+          base::BindOnce(&Registration::OnRevoked, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void Expire(uint64_t challenge) { Complete(challenge, 0, 0); }
+  void OnRevoked() {
+    if (remaining_revokes_ && --remaining_revokes_ == 0)
+      Report(kRevoked);
+  }
+  void Fail() {
+    if (!faulted_) {
+      faulted_ = true;
+      Report(kFault);
+      Revoke();
+    }
+  }
+  void Report(uint32_t state) {
+    if (terminal_reported_)
+      return;
+    if (state == kRevoked)
+      terminal_reported_ = true;
+    if (input_.on_state)
+      input_.on_state(input_.user_data, input_.context_token, input_.generation,
+                      state);
+  }
+  cef_sorng_tls_context_v2 input_;
+  CefBrowserContext* context_ = nullptr;
+  const std::vector<std::vector<uint8_t>> roots_;
+  bool revoked_ = false;
+  bool faulted_ = false;
+  bool terminal_reported_ = false;
+  uint64_t next_challenge_ = 0;
+  size_t remaining_revokes_ = 0;
+  struct Pending { EvaluateCallback callback; int error; uint32_t status; bool fatal; };
+  std::map<uint64_t, Pending> pending_;
+  mojo::ReceiverSet<network::mojom::SorngTlsClient> receivers_;
+  std::vector<std::unique_ptr<mojo::Remote<network::mojom::SorngTlsControl>>>
+      controls_;
+  base::WeakPtrFactory<Registration> weak_factory_{this};
+};
+using Registry = std::map<uint64_t, std::unique_ptr<Registration>>;
+Registry& Registrations() {
+  // Retain tombstones; never let a recycled token gain an old grant.
+  static base::NoDestructor<Registry> registrations;
+  return *registrations;
+}
+Registration* Find(uint64_t token, uint64_t generation) {
+  auto it = Registrations().find(token);
+  return it != Registrations().end() && it->second->generation() == generation
+             ? it->second.get()
+             : nullptr;
+}
+}  // namespace
+
+void CefSorngAttachTls(CefBrowserContext* context, uint64_t token) {
+  CHECK(OnUi());
+  auto it = Registrations().find(token);
+  CHECK(it != Registrations().end());
+  it->second->Attach(context);
+}
+void CefSorngDetachTls(CefBrowserContext* context) {
+  CHECK(OnUi());
+  for (const auto& [token, registration] : Registrations()) {
+    if (registration->Matches(context)) { registration->Detach(); return; }
+  }
+}
+void CefSorngConfigureTls(CefBrowserContext* context,
+                          network::mojom::NetworkContextParams* params,
+                          cert_verifier::mojom::CertVerifierCreationParams* cert_params) {
+  CHECK(OnUi());
+  for (const auto& [token, registration] : Registrations()) {
+    if (registration->Matches(context)) {
+      registration->ConfigureRoots(cert_params);
+      params->sorng_tls_generation = registration->generation();
+      params->sorng_tls_client = registration->Bind();
+      return;
+    }
+  }
+}
+
+CefRefPtr<CefRequestContext> CefSorngCreateContext(
+    const cef_sorng_tls_context_v2* input, const CefRequestContextSettings& settings,
+    CefRefPtr<CefRequestContextHandler> handler) {
+  if (!OnUi() || !input || input->size != sizeof(*input) ||
+      input->abi_version != CEF_SORNG_TLS_ABI_V2 || !input->context_token ||
+      !input->generation || !input->on_evidence || !input->on_state ||
+      input->reserved || input->ca_mode > 2 || input->trust_anchor_count > 64 ||
+      Registrations().size() >= 1024 || Registrations().contains(input->context_token) ||
+      !CefString(&settings.cache_path).empty() || settings.persist_session_cookies)
+    return nullptr;
+  if ((input->ca_mode == 0) != (input->trust_anchor_count == 0) ||
+      (input->trust_anchor_count && !input->trust_anchors)) return nullptr;
+#if !BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
+  if (input->ca_mode != 0) return nullptr;
+#endif
+  std::vector<std::vector<uint8_t>> roots;
+  size_t total = 0;
+  for (size_t i = 0; i < input->trust_anchor_count; ++i) {
+    const auto& root = input->trust_anchors[i];
+    if (!root.data || !root.length || root.length > 256 * 1024 ||
+        (total += root.length) > 4 * 1024 * 1024) return nullptr;
+    roots.emplace_back(root.data, root.data + root.length);
+    auto parsed = bssl::ParsedCertificate::Create(
+        net::x509_util::CreateCryptoBuffer(roots.back()),
+        net::x509_util::DefaultParseCertificateOptions(), nullptr);
+    if (!parsed || !parsed->has_basic_constraints() ||
+        !parsed->basic_constraints().is_ca) return nullptr;
+  }
+  auto registration = std::make_unique<Registration>(*input, std::move(roots));
+  auto* registered = registration.get();
+  Registrations().emplace(input->context_token, std::move(registration));
+  auto context = CefRequestContextImpl::CreateWithSorngTls(settings, handler, input->context_token);
+  if (!context) registered->Abandon();
+  return context;
+}
+
+extern "C" {
+const cef_sorng_tls_api_v2* SORNG_TLS_CALL cef_sorng_tls_get_api_v2(void) {
+  static constexpr cef_sorng_tls_api_v2 api{
+      sizeof(cef_sorng_tls_api_v2),
+      CEF_SORNG_TLS_ABI_V2,
+      CEF_SORNG_TLS_CAP_SOCKET_ADMISSION | CEF_SORNG_TLS_CAP_CONTEXT_REVOKE |
+          CEF_SORNG_TLS_CAP_HTTP1_ONLY | CEF_SORNG_TLS_CAP_SCOPED_EXCEPTIONS |
+          CEF_SORNG_TLS_CAP_PRIVATE_CONTEXT
+#if BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
+          | CEF_SORNG_TLS_CAP_CUSTOM_CA
+#endif
+          ,
+      "682c378d70d5780061e96644dca16ddd8fd157a9",
+      "154.0.8037.58",
+      "sorng-tls-v2-682c378-1"};
+  return &api;
+}
+int SORNG_TLS_CALL cef_sorng_tls_complete_v2(uint64_t token,
+                                             uint64_t generation,
+                                             uint64_t challenge,
+                                             uint32_t decision, uint32_t exception_mask) {
+  if (!OnUi())
+    return 0;
+  auto* registration = Find(token, generation);
+  return registration && registration->Complete(challenge, decision, exception_mask);
+}
+int SORNG_TLS_CALL cef_sorng_tls_revoke_v2(uint64_t token,
+                                           uint64_t generation) {
+  if (!OnUi())
+    return 0;
+  auto* registration = Find(token, generation);
+  if (!registration)
+    return 0;
+  registration->Revoke();
+  return 1;
+}
+}  // extern "C"
