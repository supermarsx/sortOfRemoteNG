+void ProxyConfigMonitor::ConfirmSorngFixedProxy(
+    uint16_t port,
+    base::OnceCallback<void(bool, uint64_t)> done) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  net::ProxyConfig expected;
+  expected.proxy_rules().ParseFromString("http://127.0.0.1:" +
+                                         base::NumberToString(port));
+  expected.proxy_rules().bypass_rules.AddRulesToSubtractImplicit();
+  auto matches = [this, &expected]() {
+    net::ProxyConfigWithAnnotation current;
+    return proxy_config_service_->GetLatestProxyConfig(&current) ==
+               net::ProxyConfigService::CONFIG_VALID &&
+           current.value().Equals(expected);
+  };
+  if (!port || proxy_config_client_set_.empty() ||
+      proxy_config_client_set_.size() > 64 || !matches()) {
+    std::move(done).Run(false, 0);
+    return;
+  }
+  // This is deliberately the same remote/receiver pipe as OnProxyConfigUpdated.
+  // A NetworkContext callback on another pipe would not fence that update.
+  auto complete = base::BarrierCallback<bool>(
+      proxy_config_client_set_.size(),
+      base::BindOnce(
+          [](base::WeakPtr<ProxyConfigMonitor> self, net::ProxyConfig expected,
+             uint64_t generation, base::OnceCallback<void(bool, uint64_t)> done,
+             std::vector<bool> results) {
+            net::ProxyConfigWithAnnotation current;
+            const bool valid =
+                self && self->proxy_config_generation_ == generation &&
+                std::all_of(results.begin(), results.end(),
+                            [](bool ok) { return ok; }) &&
+                self->proxy_config_service_->GetLatestProxyConfig(&current) ==
+                    net::ProxyConfigService::CONFIG_VALID &&
+                current.value().Equals(expected);
+            std::move(done).Run(valid, generation);
+          },
+          weak_factory_.GetWeakPtr(), expected, proxy_config_generation_,
+          std::move(done)));
+  for (auto& client : proxy_config_client_set_) {
+    auto observed = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        base::BindOnce([](base::RepeatingCallback<void(bool)> complete,
+                          bool ok) { complete.Run(ok); },
+                       complete),
+        false);
+    client->FlushProxyConfig(base::BindOnce(std::move(observed), true));
+  }
+}
