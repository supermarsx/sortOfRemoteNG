+void NetworkContext::LookUpSorngFixedProxy(
+    uint16_t port,
+    mojo::PendingRemote<mojom::ProxyLookupClient> client) {
+  if (!client)
+    return;
+  mojo::Remote<mojom::ProxyLookupClient> reply(std::move(client));
+  net::ConfiguredProxyResolutionService* service = nullptr;
+  net::ProxyInfo info;
+  if (!params_->sorng_tls_generation || !port ||
+      !url_request_context()
+           ->proxy_resolution_service()
+           ->CastToConfiguredProxyResolutionService(&service) ||
+      !service->GetSorngFixedProxy(port, &info)) {
+    reply->OnProxyLookupComplete(net::ERR_PROXY_CONNECTION_FAILED,
+                                 std::nullopt);
+    return;
+  }
+  reply->OnProxyLookupComplete(net::OK, info);
+}
