+bool ConfiguredProxyResolutionService::GetSorngFixedProxy(uint16_t port,
+                                                          ProxyInfo* result) {
+  if (!port || !result)
+    return false;
+  ProxyConfig expected;
+  expected.proxy_rules().ParseFromString("http://127.0.0.1:" +
+                                         base::NumberToString(port));
+  expected.proxy_rules().bypass_rules.AddRulesToSubtractImplicit();
+  ProxyConfigWithAnnotation latest;
+  if (config_service_->GetLatestProxyConfig(&latest) !=
+          ProxyConfigService::CONFIG_VALID ||
+      !latest.value().Equals(expected) ||
+      (fetched_config_ && !fetched_config_->value().Equals(expected)) ||
+      (config_ && !config_->value().Equals(expected)))
+    return false;
+  // Fixed all-scheme rules determine this exact route without invoking the
+  // generic resolver (which could otherwise run PAC after a cross-pipe race).
+  result->UseProxyList(latest.value().proxy_rules().single_proxies);
+  return true;
+}
