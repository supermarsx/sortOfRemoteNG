+      proxy_, HostPortPair("example.test", 443), factory.get());
+  int callbacks = 0;
+  ASSERT_EQ(ERR_IO_PENDING,
+            socket->ConnectAsync(
+                proxy_->endpoint(),
+                base::BindOnce(
+                    [](scoped_refptr<Admission> admission,
+                       std::unique_ptr<SorngCapsuleDatagramClientSocket>* owned,
+                       std::unique_ptr<LifetimeFactory>* factory,
+                       StreamLifetime* state, int* count, int result) {
+                      EXPECT_EQ(ERR_ABORTED, result);
+                      EXPECT_EQ(0, state->streams);
+                      EXPECT_TRUE(state->factory_alive);
+                      ++*count;
