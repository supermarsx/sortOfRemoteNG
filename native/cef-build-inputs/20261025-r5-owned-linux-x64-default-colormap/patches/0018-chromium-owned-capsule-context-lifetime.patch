+TEST_F(SorngCapsuleSocketTest, CloseReleasesFactoryAndStreamBeforeOwnerDies) {
+  StreamLifetime lifetime;
+  StaticSocketDataProvider pending;
+  pending.set_connect_data(MockConnect(ASYNC, ERR_IO_PENDING));
+  auto factory = std::make_unique<LifetimeFactory>(&pending, &lifetime);
+  auto socket = std::make_unique<SorngCapsuleDatagramClientSocket>(
+      proxy_, HostPortPair("example.test", 443), factory.get());
+  int callbacks = 0;
+  ASSERT_EQ(ERR_IO_PENDING,
+            socket->ConnectAsync(
+                proxy_->endpoint(),
+                base::BindOnce([](int* count, int) { ++*count; }, &callbacks)));
+  ASSERT_EQ(1, lifetime.streams);
+  socket->Close();
+  EXPECT_EQ(0, lifetime.streams);
+  EXPECT_EQ(1, lifetime.destroyed);
+  // Keep the closed capsule alive beyond its creating factory, like a retained
+  // asynchronous QUIC callback. No BRP/DPD suppression is used.
+  factory.reset();
+  socket->Close();
+  admission_->Revoke();
+  socket.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(0, callbacks);  // Explicit Close cancels owner callbacks.
+  EXPECT_EQ(1, lifetime.destroyed);
+}
+TEST_F(SorngCapsuleSocketTest,
+       RevokeCompletesPendingConnectExactlyOnceAndDropsStream) {
+  StreamLifetime lifetime;
+  StaticSocketDataProvider pending;
+  pending.set_connect_data(MockConnect(ASYNC, ERR_IO_PENDING));
+  auto factory = std::make_unique<LifetimeFactory>(&pending, &lifetime);
