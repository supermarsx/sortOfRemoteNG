+  EXPECT_EQ(ERR_ABORTED,
+            socket->ConnectAsync(proxy_->endpoint(), ignored.callback()));
+  socket.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1, callbacks);
