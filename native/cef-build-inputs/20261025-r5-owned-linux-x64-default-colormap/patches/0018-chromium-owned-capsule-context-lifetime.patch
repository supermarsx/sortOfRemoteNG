+      proxy_, HostPortPair("example.test", 443), factory.get());
+  int callbacks = 0;
+  int terminal = OK;
+  ASSERT_EQ(ERR_IO_PENDING,
+            socket->ConnectAsync(proxy_->endpoint(),
+                                 base::BindOnce(
+                                     [](int* count, int* terminal, int result) {
+                                       ++*count;
+                                       *terminal = result;
+                                     },
+                                     &callbacks, &terminal)));
+  admission_->Revoke();
+  EXPECT_EQ(1, callbacks);
+  EXPECT_EQ(ERR_ABORTED, terminal);
+  EXPECT_EQ(0, lifetime.streams);
+  EXPECT_EQ(1, lifetime.destroyed);
+  factory.reset();
+  admission_->Revoke();
+  socket->Close();
+  auto bytes = base::MakeRefCounted<StringIOBuffer>("never-sent");
+  TestCompletionCallback ignored;
+  EXPECT_EQ(ERR_ABORTED,
+            socket->Write(bytes.get(), bytes->size(), ignored.callback(),
