+TEST_F(SorngDatagramConfigurationTest,
+       ContextShutdownRetiresPendingOwnedCapsuleBeforeFactoryAndLateRevoke) {
+  NativeClient first_client, successor_client;
+  first_client.hold_evaluations = true;
+  ContextStreamLifetime lifetime;
+  net::StaticSocketDataProvider pending;
+  pending.set_connect_data(net::MockConnect(net::ASYNC, net::ERR_IO_PENDING));
+  auto first =
+      Create(&first_client, 1, 32123,
+             std::make_unique<ContextLifetimeFactory>(&pending, &lifetime));
+  ASSERT_TRUE(Configure(first_client, 1, 32123));
+  auto successor = Create(&successor_client, 2, 32124);
+  ASSERT_TRUE(Configure(successor_client, 2, 32124));
+  scoped_refptr<net::SorngDatagramProxy> proxy =
+      first.session()->quic_session_pool()->sorng_datagram_proxy();
+  scoped_refptr<net::SSLClientContext::TlsAdmissionDelegate> admission =
+      proxy->admission();
+  auto socket = std::make_unique<net::SorngCapsuleDatagramClientSocket>(
+      proxy, net::HostPortPair("example.test", 443),
+      first.session()->context().client_socket_factory);
+  int connect_callbacks = 0;
+  ASSERT_EQ(
+      net::ERR_IO_PENDING,
+      socket->ConnectAsync(proxy->endpoint(),
+                           base::BindOnce([](int* count, int) { ++*count; },
+                                          &connect_callbacks)));
+  ASSERT_EQ(1, lifetime.streams);
+  auto certificate =
+      net::ImportCertFromFile(net::GetTestCertsDirectory(), "ok_cert.pem");
+  ASSERT_TRUE(certificate);
+  net::CertVerifyResult verified;
+  verified.verified_cert = certificate;
+  int terminal_callbacks = 0;
+  int terminal_error = net::OK;
+  admission->Verify(
+      net::HostPortPair("example.test", 443), certificate, verified, net::OK,
+      false,
+      base::BindOnce(
+          [](std::unique_ptr<net::SorngCapsuleDatagramClientSocket> retained,
+             int* count, int* result, ContextStreamLifetime* state,
+             NativeClient* native, int error) {
+            EXPECT_TRUE(state->factory_alive);
+            ++*count;
+            *result = error;
+            // Exercise the real admission implementation reentrantly while the
+            // pending closure still owns the capsule. Each snapshot must
+            // tolerate socket unregistration and the later outer shutdown pass.
+            base::test::TestFuture<void> nested_revoke;
+            native->control->Revoke(1, nested_revoke.GetCallback());
+            EXPECT_TRUE(nested_revoke.Wait());
+            EXPECT_EQ(0, state->streams);
+            EXPECT_EQ(1, state->destroyed);
+            auto payload =
+                base::MakeRefCounted<net::StringIOBuffer>("never-sent");
+            EXPECT_EQ(
+                net::ERR_ABORTED,
+                retained->Write(payload.get(), 10, base::BindOnce([](int) {
+                                  ADD_FAILURE() << "closed payload callback";
+                                }),
+                                TRAFFIC_ANNOTATION_FOR_TESTS));
+            // Destruction is deliberately at callback scope exit, like the
+            // pending QUIC session-creation closure in the actual fatal stack.
+          },
+          std::move(socket), &terminal_callbacks, &terminal_error, &lifetime,
+          &first_client));
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(1u, first_client.pending.size());
+  EXPECT_EQ(0, terminal_callbacks);
+  first.value.reset();
+  EXPECT_EQ(1, terminal_callbacks);
+  EXPECT_EQ(net::ERR_BLOCKED_BY_CLIENT, terminal_error);
+  EXPECT_EQ(0, lifetime.streams);
+  EXPECT_EQ(1, lifetime.destroyed);
+  EXPECT_FALSE(lifetime.factory_alive);
+  EXPECT_FALSE(admission->IsActive());
+  EXPECT_TRUE(successor.session()
+                  ->quic_session_pool()
+                  ->sorng_datagram_proxy()
+                  ->IsActive());
+  // A late allow reply, duplicate revoke and Mojo disconnect cannot revive the
+  // old context, deliver twice, or close the simultaneously live successor.
+  std::move(first_client.pending.front()).Run(1, 0);
+  for (int i = 0; i < 2; ++i) {
+    base::test::TestFuture<void> revoked;
+    first_client.control->Revoke(1, revoked.GetCallback());
+    ASSERT_TRUE(revoked.Wait());
+  }
+  first_client.control.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1, terminal_callbacks);
+  EXPECT_EQ(1, connect_callbacks);
+  EXPECT_EQ(1, lifetime.destroyed);
+  EXPECT_FALSE(admission->IsActive());
+  EXPECT_TRUE(successor.session()
+                  ->quic_session_pool()
+                  ->sorng_datagram_proxy()
+                  ->IsActive());
