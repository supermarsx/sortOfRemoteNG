+
+bool QuicSessionPool::IsSorngProxyChain(const ProxyChain& chain) const {
+  if (!sorng_datagram_proxy_ || !sorng_datagram_proxy_->IsActive() ||
+      chain.is_direct() || chain.length() != 1) {
+    return false;
+  }
+  const ProxyServer& proxy = chain.First();
+  return proxy.is_http() && proxy.host_port_pair() ==
+      HostPortPair::FromIPEndPoint(sorng_datagram_proxy_->endpoint());
+}
