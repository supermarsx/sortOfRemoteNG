+class NativeClient final : public mojom::SorngTlsClient {
+ public:
+  mojo::PendingRemote<mojom::SorngTlsClient> Bind() {
+    return receiver_.BindNewPipeAndPassRemote();
+  }
+  void Ready(mojo::PendingRemote<mojom::SorngTlsControl> remote) override {
+    control.Bind(std::move(remote));
+  }
+  void Evaluate(uint64_t,
+                const std::string&,
+                uint16_t,
+                const scoped_refptr<net::X509Certificate>&,
+                const net::CertVerifyResult&,
+                int32_t,
+                bool,
+                EvaluateCallback callback) override {
+    std::move(callback).Run(0, 0);
+  }
+  mojo::Remote<mojom::SorngTlsControl> control;
+
+ private:
+  mojo::Receiver<mojom::SorngTlsClient> receiver_{this};
+};
+class SorngDatagramConfigurationTest : public testing::Test {
+ protected:
+  struct Context {
+    mojo::Remote<mojom::NetworkContext> remote;
+    std::unique_ptr<NetworkContext> value;
+    net::HttpNetworkSession* session() {
+      return value->url_request_context()
+          ->http_transaction_factory()
+          ->GetSession();
+    }
+  };
+  Context Create(NativeClient* client, uint64_t generation, uint16_t port) {
+    auto params = CreateNetworkContextParamsForTesting();
+    params->cert_verifier_params =
+        FakeTestCertVerifierParamsFactory::GetCertVerifierParams();
+    net::ProxyConfig proxy;
+    if (port) {
+      proxy.proxy_rules().ParseFromString("http://127.0.0.1:" +
+                                          base::NumberToString(port));
+      proxy.proxy_rules().bypass_rules.AddRulesToSubtractImplicit();
+    }
+    params->initial_proxy_config =
+        net::ProxyConfigWithAnnotation(proxy, TRAFFIC_ANNOTATION_FOR_TESTS);
+    if (client) {
+      params->sorng_tls_client = client->Bind();
+      params->sorng_tls_generation = generation;
+    }
+    Context context;
+    context.value = NetworkContext::CreateForTesting(
+        service_.get(), context.remote.BindNewPipeAndPassReceiver(),
+        std::move(params), {});
+    task_environment_.RunUntilIdle();
+    return context;
+  }
+  bool Configure(NativeClient& client, uint64_t generation, uint16_t port) {
+    base::test::TestFuture<bool> result;
+    client.control->ConfigureDatagrams(generation, port, std::string(64, 'a'),
+                                       result.GetCallback());
+    return result.Get();
+  }
+  static std::unique_ptr<NetworkService> CreateService() {
+    static const bool initialized = [] {
+      mojo::core::Init();
+      return true;
+    }();
+    CHECK(initialized);
+    return NetworkService::CreateForTesting();
+  }
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::IO};
+  std::unique_ptr<net::NetworkChangeNotifier> notifier_ =
+      net::NetworkChangeNotifier::CreateMockIfNeeded();
+  std::unique_ptr<NetworkService> service_ = CreateService();
+};
+TEST_F(SorngDatagramConfigurationTest, OnlyExactNativeContextCanEnableQuic) {
+  service_->DisableQuic();
+  NativeClient first_client, successor_client;
+  auto first = Create(&first_client, 1, 32123);
+  auto successor = Create(&successor_client, 2, 32124);
+  auto ordinary = Create(nullptr, 0, 32125);
+  EXPECT_FALSE(first.session()->IsQuicEnabled());
+  EXPECT_FALSE(successor.session()->IsQuicEnabled());
+  EXPECT_FALSE(ordinary.session()->IsQuicEnabled());
+  EXPECT_TRUE(Configure(first_client, 1, 32123));
+  EXPECT_TRUE(first.session()->IsQuicEnabled());
+  EXPECT_FALSE(successor.session()->IsQuicEnabled());
+  EXPECT_FALSE(ordinary.session()->IsQuicEnabled());
+  EXPECT_FALSE(
+      ordinary.value->ConfigureSorngDatagrams(32125, std::string(64, 'a')));
+  EXPECT_TRUE(Configure(successor_client, 2, 32124));
+  base::test::TestFuture<void> revoked;
+  first_client.control->Revoke(1, revoked.GetCallback());
+  ASSERT_TRUE(revoked.Wait());
+  EXPECT_FALSE(
+      first.session()->quic_session_pool()->sorng_datagram_proxy()->IsActive());
+  EXPECT_TRUE(successor.session()->IsQuicEnabled());
+  EXPECT_TRUE(successor.session()
+                  ->quic_session_pool()
+                  ->sorng_datagram_proxy()
+                  ->IsActive());
+  EXPECT_FALSE(Configure(first_client, 1, 32123));
+  EXPECT_TRUE(successor.session()
+                  ->quic_session_pool()
+                  ->sorng_datagram_proxy()
+                  ->IsActive());
+  EXPECT_FALSE(ordinary.session()->IsQuicEnabled());
+}
+TEST_F(SorngDatagramConfigurationTest, ReplacementMustProveItsOwnCurrentProxy) {
+  service_->DisableQuic();
+  NativeClient old_client, replacement_client, direct_client, late_client;
+  auto old = Create(&old_client, 1, 32123);
+  ASSERT_TRUE(Configure(old_client, 1, 32123));
+  auto replacement = Create(&replacement_client, 2, 32124);
+  auto direct = Create(&direct_client, 3, 0);
+  auto late_partition = Create(&late_client, 1, 32123);
+  EXPECT_FALSE(late_partition.session()->IsQuicEnabled());
+  EXPECT_TRUE(Configure(late_client, 1, 32123));
+  // The old context's success cannot authorize a different or DIRECT route.
+  EXPECT_FALSE(Configure(replacement_client, 2, 32123));
+  EXPECT_FALSE(Configure(direct_client, 3, 32123));
+  EXPECT_FALSE(replacement.session()->IsQuicEnabled());
+  EXPECT_FALSE(direct.session()->IsQuicEnabled());
+  EXPECT_TRUE(late_partition.session()->IsQuicEnabled());
+  EXPECT_TRUE(
+      old.session()->quic_session_pool()->sorng_datagram_proxy()->IsActive());
+}
