+namespace net {
+QuicSessionPool::OwnedProxyJob::OwnedProxyJob(
+    QuicSessionPool* pool,
+    quic::ParsedQuicVersion version,
+    QuicSessionAliasKey key,
+    std::unique_ptr<CryptoClientConfigHandle> crypto_config,
+    RequestPriority priority,
+    int cert_verify_flags,
+    MultiplexedSessionCreationInitiator initiator,
+    QuicConnectionReuseDetails reuse,
+    const NetLogWithSource& net_log)
+    : Job(pool,
+          std::move(key),
+          std::move(crypto_config),
+          priority,
+          initiator,
+          reuse,
+          net_log),
+      version_(version),
+      cert_verify_flags_(cert_verify_flags) {}
+QuicSessionPool::OwnedProxyJob::~OwnedProxyJob() = default;
+int QuicSessionPool::OwnedProxyJob::Run(CompletionOnceCallback callback) {
+  auto proxy = pool_->sorng_datagram_proxy();
+  if (!proxy || !proxy->IsActive() ||
+      !pool_->IsSorngProxyChain(key_.session_key().proxy_chain())) {
+    return ERR_NO_SUPPORTED_PROXIES;
+  }
+  attempt_ = std::make_unique<QuicSessionAttempt>(
+      this, proxy->endpoint(), ConnectionEndpointMetadata{}, version_,
+      cert_verify_flags_, base::TimeTicks(), base::TimeTicks(), std::nullopt,
+      false, false, std::set<std::string>(), nullptr,
+      session_creation_initiator_, quic_connection_reuse_details_,
+      std::nullopt);
+  int result = attempt_->Start(
+      base::BindOnce(&OwnedProxyJob::OnComplete, weak_factory_.GetWeakPtr()));
+  if (result == ERR_IO_PENDING) {
+    callback_ = std::move(callback);
+  }
+  return result;
+}
+void QuicSessionPool::OwnedProxyJob::SetRequestExpectations(
+    QuicSessionRequest* request) {
+  if (attempt_ && !attempt_->session_creation_finished()) {
+    request->ExpectQuicSessionCreation();
+  }
+}
+void QuicSessionPool::OwnedProxyJob::PopulateNetErrorDetails(
+    NetErrorDetails* details) const {
+  if (attempt_) {
+    attempt_->PopulateNetErrorDetails(details);
+  }
+}
+void QuicSessionPool::OwnedProxyJob::OnComplete(int result) {
+  if (callback_) {
+    std::move(callback_).Run(result);
+  }
+}
+}  // namespace net
