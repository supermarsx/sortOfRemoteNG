--- /dev/null
+++ b/net/socket/sorng_capsule_datagram_client_socket.cc
@@ -0,0 +1,577 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "net/socket/sorng_capsule_datagram_client_socket.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "net/base/address_list.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_util.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace net {
+namespace {
+constexpr size_t kMaximumHeaders = 16 * 1024;
+constexpr uint64_t kMaximumCapsule = 65543;
+constexpr size_t kMaximumQueue = 16;
+constexpr auto kAnnotation =
+    DefineNetworkTrafficAnnotation("sorng_owned_quic_capsules", R"(
+      semantics {
+        sender: "Owned embedded browser QUIC transport"
+        description: "Carries encrypted QUIC datagrams inside an authenticated local TCP relay."
+        trigger: "A user opens an HTTPS page through an owned private browser context."
+        data: "Ephemeral relay authentication and encrypted QUIC packets."
+        destination: LOCAL
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Only available for native-owned routes with explicit datagram capability."
+        policy_exception_justification: "Owned local transport; no direct UDP fallback."
+      })");
+
+std::optional<std::pair<uint64_t, size_t>> Varint(std::string_view input) {
+  if (input.empty()) {
+    return std::nullopt;
+  }
+  const size_t length = size_t{1} << (static_cast<uint8_t>(input[0]) >> 6);
+  if (input.size() < length) {
+    return std::nullopt;
+  }
+  uint64_t value = static_cast<uint8_t>(input[0]) & 63;
+  for (size_t i = 1; i < length; ++i) {
+    value = (value << 8) | static_cast<uint8_t>(input[i]);
+  }
+  return std::make_pair(value, length);
+}
+void AppendVarint(std::string& output, uint64_t value) {
+  const size_t length = value < 64 ? 1 : value < 16384 ? 2 : 4;
+  for (size_t i = length; i > 0; --i) {
+    output.push_back(static_cast<char>(value >> ((i - 1) * 8)));
+  }
+  output[output.size() - length] |= length == 1 ? 0 : length == 2 ? 0x40 : 0x80;
+}
+std::optional<std::string> TargetPath(const HostPortPair& destination) {
+  if (!destination.port() || destination.host().empty()) {
+    return std::nullopt;
+  }
+  std::string host = destination.host();
+  if (host.front() == '[' && host.back() == ']') {
+    host = host.substr(1, host.size() - 2);
+  }
+  IPAddress address;
+  if (address.AssignFromIPLiteral(host)) {
+    host = address.ToString();
+  } else {
+    if (host.size() > 253 || !std::ranges::all_of(host, [](char c) {
+          return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '.' ||
+                 c == '-' || c == '_';
+        })) {
+      return std::nullopt;
+    }
+    host = base::ToLowerASCII(host);
+  }
+  std::string component;
+  for (char c : host) {
+    component += c == ':' ? "%3A" : std::string(1, c);
+  }
+  return "/.well-known/masque/udp/" + component + "/" +
+         base::NumberToString(destination.port()) + "/";
+}
+}  // namespace
+
+scoped_refptr<SorngDatagramProxy> SorngDatagramProxy::Create(
+    uint16_t port,
+    std::string password,
+    scoped_refptr<SSLClientContext::TlsAdmissionDelegate> admission) {
+  if (!port || password.size() != 64 || !admission || !admission->IsActive() ||
+      !std::ranges::all_of(password,
+                           [](char c) { return base::IsHexDigit(c); })) {
+    return nullptr;
+  }
+  return base::WrapRefCounted(
+      new SorngDatagramProxy(port, std::move(password), std::move(admission)));
+}
+SorngDatagramProxy::SorngDatagramProxy(
+    uint16_t port,
+    std::string password,
+    scoped_refptr<SSLClientContext::TlsAdmissionDelegate> admission)
+    : endpoint_(IPAddress::IPv4Localhost(), port),
+      password_(std::move(password)),
+      admission_(std::move(admission)) {}
+SorngDatagramProxy::~SorngDatagramProxy() {
+  OPENSSL_cleanse(password_.data(), password_.size());
+}
+bool SorngDatagramProxy::IsActive() const {
+  return admission_->IsActive();
+}
+std::string SorngDatagramProxy::Authorization() const {
+  return "Basic " + base::Base64Encode("sorng-private-proxy:" + password_);
+}
+
+SorngCapsuleDatagramClientSocket::SorngCapsuleDatagramClientSocket(
+    scoped_refptr<SorngDatagramProxy> proxy,
+    HostPortPair destination,
+    ClientSocketFactory* factory)
+    : proxy_(std::move(proxy)),
+      destination_(std::move(destination)),
+      factory_(factory),
+      receive_(base::MakeRefCounted<IOBufferWithSize>(8192)) {
+  CHECK(proxy_);
+  CHECK(factory_);
+  proxy_->admission()->AddSocket(
+      this, base::BindRepeating(&SorngCapsuleDatagramClientSocket::OnRevoked,
+                                weak_factory_.GetWeakPtr()));
+}
+SorngCapsuleDatagramClientSocket::~SorngCapsuleDatagramClientSocket() {
+  Close();
+}
+bool SorngCapsuleDatagramClientSocket::Active() const {
+  return state_ != State::kClosed && proxy_->IsActive();
+}
+int SorngCapsuleDatagramClientSocket::Connect(const IPEndPoint&) {
+  return ERR_NOT_IMPLEMENTED;  // The authenticated upgrade is asynchronous.
+}
+int SorngCapsuleDatagramClientSocket::ConnectUsingNetwork(
+    handles::NetworkHandle,
+    const IPEndPoint&) {
+  return ERR_NOT_IMPLEMENTED;
+}
+int SorngCapsuleDatagramClientSocket::ConnectUsingDefaultNetwork(
+    const IPEndPoint&) {
+  return ERR_NOT_IMPLEMENTED;
+}
+int SorngCapsuleDatagramClientSocket::ConnectUsingNetworkAsync(
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  if (network != handles::kInvalidNetworkHandle) {
+    return ERR_NOT_IMPLEMENTED;
+  }
+  return ConnectAsync(address, std::move(callback));
+}
+int SorngCapsuleDatagramClientSocket::ConnectUsingDefaultNetworkAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectAsync(address, std::move(callback));
+}
+int SorngCapsuleDatagramClientSocket::ConnectAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  if (!Active()) {
+    return ERR_ABORTED;
+  }
+  if (state_ != State::kNew || address != proxy_->endpoint() ||
+      !TargetPath(destination_)) {
+    return ERR_INVALID_ARGUMENT;
+  }
+  // No resolver, UDP socket, ambient proxy, or byte-level NetLog is involved.
+  stream_ = factory_->CreateTransportClientSocket(
+      AddressList(proxy_->endpoint()), handles::kInvalidNetworkHandle, nullptr,
+      nullptr, nullptr, NetLogSource());
+  if (!stream_) {
+    return ERR_FAILED;
+  }
+  connect_callback_ = std::move(callback);
+  state_ = State::kConnecting;
+  connect_timer_.Start(
+      FROM_HERE, base::Seconds(10),
+      base::BindOnce(&SorngCapsuleDatagramClientSocket::OnConnect,
+                     weak_factory_.GetWeakPtr(), ERR_TIMED_OUT));
+  int rv = stream_->Connect(
+      base::BindOnce(&SorngCapsuleDatagramClientSocket::OnConnect,
+                     weak_factory_.GetWeakPtr()));
+  if (rv != ERR_IO_PENDING) {
+    rv = ConnectLoop(rv);
+  }
+  if (rv != ERR_IO_PENDING) {
+    connect_callback_.Reset();
+    if (rv < 0) {
+      Fail(rv);
+    }
+  }
+  return rv;
+}
+int SorngCapsuleDatagramClientSocket::ConnectLoop(int rv) {
+  if (!Active()) {
+    return ERR_ABORTED;
+  }
+  if (rv < 0) {
+    return rv;
+  }
+  if (state_ == State::kConnecting) {
+    const std::string request =
+        "GET " + *TargetPath(destination_) +
+        " HTTP/1.1\r\nHost: " + proxy_->endpoint().ToString() +
+        "\r\nProxy-Authorization: " + proxy_->Authorization() +
+        "\r\nConnection: Upgrade\r\nUpgrade: connect-udp\r\nCapsule-Protocol: "
+        "?1\r\n\r\n";
+    auto buffer = base::MakeRefCounted<StringIOBuffer>(request);
+    send_ = base::MakeRefCounted<DrainableIOBuffer>(buffer, request.size());
+    state_ = State::kRequest;
+    rv = 0;
+  }
+  if (state_ == State::kRequest) {
+    rv = WriteLoop(rv);
+    if (rv != OK) {
+      return rv;
+    }
+    state_ = State::kResponse;
+    rv = 0;
+  }
+  return state_ == State::kResponse ? ReadLoop(rv) : OK;
+}
+void SorngCapsuleDatagramClientSocket::OnConnect(int rv) {
+  rv = ConnectLoop(rv);
+  if (rv == ERR_IO_PENDING) {
+    return;
+  }
+  auto callback = std::move(connect_callback_);
+  if (rv < 0) {
+    Fail(rv);
+  }
+  if (callback) {
+    std::move(callback).Run(rv);
+  }
+}
+int SorngCapsuleDatagramClientSocket::WriteLoop(int rv) {
+  if (!Active()) {
+    return ERR_ABORTED;
+  }
+  if (rv < 0) {
+    return rv;
+  }
+  if (rv > 0) {
+    send_->DidConsume(rv);
+  }
+  while (send_ && send_->BytesRemaining()) {
+    rv = stream_->Write(
+        send_.get(), send_->BytesRemaining(),
+        base::BindOnce(&SorngCapsuleDatagramClientSocket::OnWrite,
+                       weak_factory_.GetWeakPtr()),
+        kAnnotation);
+    if (rv == ERR_IO_PENDING || rv < 0) {
+      return rv;
+    }
+    if (!rv) {
+      return ERR_CONNECTION_CLOSED;
+    }
+    send_->DidConsume(rv);
+  }
+  send_.reset();
+  return OK;
+}
+void SorngCapsuleDatagramClientSocket::OnWrite(int rv) {
+  if (connect_callback_) {
+    OnConnect(rv);
+    return;
+  }
+  rv = WriteLoop(rv);
+  if (rv == ERR_IO_PENDING) {
+    return;
+  }
+  auto callback = std::move(write_callback_);
+  const int result = rv == OK ? write_length_ : rv;
+  if (rv < 0) {
+    Fail(rv);
+  }
+  if (callback) {
+    std::move(callback).Run(result);
+  }
+}
+int SorngCapsuleDatagramClientSocket::ParseResponse() {
+  const size_t end = input_.find("\r\n\r\n");
+  if (end == std::string::npos) {
+    return input_.size() >= kMaximumHeaders ? ERR_RESPONSE_HEADERS_TOO_BIG
+                                            : ERR_IO_PENDING;
+  }
+  if (end + 4 > kMaximumHeaders) {
+    return ERR_RESPONSE_HEADERS_TOO_BIG;
+  }
+  auto headers =
+      base::MakeRefCounted<HttpResponseHeaders>(HttpUtil::AssembleRawHeaders(
+          std::string_view(input_).substr(0, end + 4)));
+  if (headers->response_code() != 101 ||
+      headers->GetHttpVersion() != HttpVersion(1, 1) ||
+      !headers->HasHeaderValue("connection", "upgrade") ||
+      !base::EqualsCaseInsensitiveASCII(
+          headers->GetNormalizedHeader("upgrade").value_or(""),
+          "connect-udp") ||
+      headers->GetNormalizedHeader("capsule-protocol").value_or("") != "?1" ||
+      headers->HasHeader("content-length") ||
+      headers->HasHeader("transfer-encoding")) {
+    return ERR_INVALID_RESPONSE;
+  }
+  input_.erase(0, end + 4);
+  state_ = State::kOpen;
+  connect_timer_.Stop();
+  return ParseCapsules();
+}
+int SorngCapsuleDatagramClientSocket::ParseCapsules() {
+  while (!input_.empty()) {
+    const auto type = Varint(input_);
+    if (!type) {
+      return OK;
+    }
+    const auto length = Varint(std::string_view(input_).substr(type->second));
+    if (!length) {
+      return OK;
+    }
+    if (length->first > kMaximumCapsule) {
+      return ERR_MSG_TOO_BIG;
+    }
+    const size_t prefix = type->second + length->second;
+    if (input_.size() < prefix + length->first) {
+      return OK;
+    }
+    const auto value = std::string_view(input_).substr(prefix, length->first);
+    if (type->first == 0) {
+      const auto context = Varint(value);
+      if (!context) {
+        return ERR_INVALID_RESPONSE;
+      }
+      if (context->first == 0) {
+        const auto payload = value.substr(context->second);
+        if (payload.size() > SorngDatagramProxy::kMaximumPayload) {
+          return ERR_MSG_TOO_BIG;
+        }
+        if (datagrams_.size() < kMaximumQueue) {
+          datagrams_.emplace_back(payload);
+        }
+      }
+    }
+    input_.erase(0, prefix + length->first);
+  }
+  return OK;
+}
+int SorngCapsuleDatagramClientSocket::ReadLoop(int rv) {
+  for (;;) {
+    if (!Active()) {
+      return ERR_ABORTED;
+    }
+    if (rv < 0) {
+      return rv;
+    }
+    if (rv > 0) {
+      input_.append(receive_->data(), rv);
+    }
+    if (state_ == State::kResponse) {
+      const int parsed = ParseResponse();
+      if (parsed != ERR_IO_PENDING) {
+        return parsed;
+      }
+    } else {
+      const int parsed = ParseCapsules();
+      if (parsed < 0) {
+        return parsed;
+      }
+      if (!datagrams_.empty()) {
+        return OK;
+      }
+    }
+    rv = stream_->Read(receive_.get(), receive_->size(),
+                       base::BindOnce(&SorngCapsuleDatagramClientSocket::OnRead,
+                                      weak_factory_.GetWeakPtr()));
+    if (rv == ERR_IO_PENDING || rv < 0) {
+      return rv;
+    }
+    if (!rv) {
+      return ERR_CONNECTION_CLOSED;
+    }
+  }
+}
+void SorngCapsuleDatagramClientSocket::OnRead(int rv) {
+  if (connect_callback_) {
+    if (!rv) {
+      rv = ERR_CONNECTION_CLOSED;
+    }
+    OnConnect(rv);
+    return;
+  }
+  if (!rv) {
+    rv = ERR_CONNECTION_CLOSED;
+  }
+  rv = ReadLoop(rv);
+  if (rv == ERR_IO_PENDING) {
+    return;
+  }
+  if (rv == OK) {
+    rv = TakeDatagram(read_buffer_, read_length_);
+  }
+  read_buffer_ = nullptr;
+  auto callback = std::move(read_callback_);
+  if (rv < 0) {
+    Fail(rv);
+  }
+  if (callback) {
+    std::move(callback).Run(rv);
+  }
+}
+int SorngCapsuleDatagramClientSocket::TakeDatagram(IOBuffer* buffer, int size) {
+  if (datagrams_.empty()) {
+    return ERR_IO_PENDING;
+  }
+  auto packet = std::move(datagrams_.front());
+  datagrams_.pop_front();
+  if (packet.size() > static_cast<size_t>(size)) {
+    return ERR_MSG_TOO_BIG;
+  }
+  buffer->span().copy_prefix_from(base::as_byte_span(packet));
+  return static_cast<int>(packet.size());
+}
+int SorngCapsuleDatagramClientSocket::Read(IOBuffer* buffer,
+                                           int size,
+                                           CompletionOnceCallback callback) {
+  if (!Active()) {
+    return ERR_ABORTED;
+  }
+  if (state_ != State::kOpen) {
+    return error_;
+  }
+  if (!buffer || size <= 0 || read_callback_) {
+    return ERR_INVALID_ARGUMENT;
+  }
+  int rv = TakeDatagram(buffer, size);
+  if (rv != ERR_IO_PENDING) {
+    return rv;
+  }
+  read_buffer_ = buffer;
+  read_length_ = size;
+  read_callback_ = std::move(callback);
+  rv = ReadLoop(0);
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  read_callback_.Reset();
+  read_buffer_ = nullptr;
+  if (rv == OK) {
+    return TakeDatagram(buffer, size);
+  }
+  Fail(rv);
+  return rv;
+}
+base::expected<DatagramsMetadata, Error>
+SorngCapsuleDatagramClientSocket::ReadMultiple(
+    IOBuffer* buffer,
+    size_t size,
+    size_t maximum,
+    base::OnceCallback<void(base::expected<DatagramsMetadata, Error>)>
+        callback) {
+  return multiple_.ReadMultiple(buffer, size, maximum, std::move(callback));
+}
+int SorngCapsuleDatagramClientSocket::Write(
+    IOBuffer* buffer,
+    int size,
+    CompletionOnceCallback callback,
+    const NetworkTrafficAnnotationTag&) {
+  if (!Active()) {
+    return ERR_ABORTED;
+  }
+  if (state_ != State::kOpen) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  if (size < 0 ||
+      size > static_cast<int>(SorngDatagramProxy::kMaximumPayload) || !buffer ||
+      send_) {
+    return ERR_MSG_TOO_BIG;
+  }
+  std::string capsule;
+  AppendVarint(capsule, 0);
+  AppendVarint(capsule, size + 1);
+  capsule.push_back(0);
+  capsule.append(buffer->data(), size);
+  auto bytes = base::MakeRefCounted<StringIOBuffer>(capsule);
+  send_ = base::MakeRefCounted<DrainableIOBuffer>(bytes, capsule.size());
+  write_length_ = size;
+  write_callback_ = std::move(callback);
+  const int rv = WriteLoop(0);
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  write_callback_.Reset();
+  if (rv < 0) {
+    Fail(rv);
+    return rv;
+  }
+  return size;
+}
+void SorngCapsuleDatagramClientSocket::OnRevoked() {
+  auto connecting = std::move(connect_callback_);
+  Fail(ERR_ABORTED);
+  if (connecting) {
+    std::move(connecting).Run(ERR_ABORTED);
+  }
+}
+void SorngCapsuleDatagramClientSocket::Close() {
+  state_ = State::kClosed;
+  connect_timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  proxy_->admission()->RemoveSocket(this);
+  if (stream_) {
+    stream_->Disconnect();
+  }
+  connect_callback_.Reset();
+  read_callback_.Reset();
+  write_callback_.Reset();
+  read_buffer_ = nullptr;
+  send_.reset();
+  input_.clear();
+  datagrams_.clear();
+}
+void SorngCapsuleDatagramClientSocket::Fail(int error) {
+  Close();
+  error_ = error;
+}
+handles::NetworkHandle SorngCapsuleDatagramClientSocket::GetBoundNetwork()
+    const {
+  return handles::kInvalidNetworkHandle;
+}
+void SorngCapsuleDatagramClientSocket::ApplySocketTag(const SocketTag&) {}
+int SorngCapsuleDatagramClientSocket::SetMulticastInterface(uint32_t) {
+  return ERR_NOT_IMPLEMENTED;
+}
+void SorngCapsuleDatagramClientSocket::SetIOSNetworkServiceType(int) {}
+int SorngCapsuleDatagramClientSocket::GetPeerAddress(
+    IPEndPoint* address) const {
+  if (state_ != State::kOpen) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  *address = proxy_->endpoint();
+  return OK;
+}
+int SorngCapsuleDatagramClientSocket::GetLocalAddress(
+    IPEndPoint* address) const {
+  return stream_ ? stream_->GetLocalAddress(address) : ERR_SOCKET_NOT_CONNECTED;
+}
+void SorngCapsuleDatagramClientSocket::UseNonBlockingIO() {}
+int SorngCapsuleDatagramClientSocket::SetDoNotFragment() {
+  return ERR_NOT_IMPLEMENTED;
+}
+int SorngCapsuleDatagramClientSocket::SetRecvTos() {
+  return OK;
+}
+int SorngCapsuleDatagramClientSocket::SetTos(DiffServCodePoint, EcnCodePoint) {
+  return OK;
+}
+void SorngCapsuleDatagramClientSocket::SetMsgConfirm(bool) {}
+const NetLogWithSource& SorngCapsuleDatagramClientSocket::NetLog() const {
+  return net_log_;
+}
+DscpAndEcn SorngCapsuleDatagramClientSocket::GetLastTos() const {
+  return {DSCP_DEFAULT, ECN_DEFAULT};
+}
+int SorngCapsuleDatagramClientSocket::SetReceiveBufferSize(int32_t) {
+  return OK;
+}
+int SorngCapsuleDatagramClientSocket::SetSendBufferSize(int32_t) {
+  return OK;
+}
+}  // namespace net
