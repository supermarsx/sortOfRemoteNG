+class ClientSocketFactory;
+
+// Network-sequence-only, immutable native authority. Never renderer supplied.
+class NET_EXPORT_PRIVATE SorngDatagramProxy
+    : public base::RefCounted<SorngDatagramProxy> {
+ public:
+  static constexpr size_t kMaximumPayload = 1232;
+  static scoped_refptr<SorngDatagramProxy> Create(
+      uint16_t port,
+      std::string password,
+      scoped_refptr<SSLClientContext::TlsAdmissionDelegate> admission);
+  bool IsActive() const;
+  const IPEndPoint& endpoint() const { return endpoint_; }
+  SSLClientContext::TlsAdmissionDelegate* admission() const {
+    return admission_.get();
+  }
+  std::string Authorization() const;
+
+ private:
+  friend class base::RefCounted<SorngDatagramProxy>;
+  SorngDatagramProxy(
+      uint16_t port,
+      std::string password,
+      scoped_refptr<SSLClientContext::TlsAdmissionDelegate> admission);
+  ~SorngDatagramProxy();
+  const IPEndPoint endpoint_;
+  std::string password_;
+  const scoped_refptr<SSLClientContext::TlsAdmissionDelegate> admission_;
+};
+
+// RFC 9298 HTTP/1.1 Upgrade + RFC 9297 capsules, over authenticated owned
+// loopback TCP only. It never creates a UDP socket or resolves a hostname.
+class NET_EXPORT_PRIVATE SorngCapsuleDatagramClientSocket final
+    : public DatagramClientSocket {
+ public:
+  SorngCapsuleDatagramClientSocket(scoped_refptr<SorngDatagramProxy> proxy,
+                                   HostPortPair destination,
+                                   ClientSocketFactory* factory);
+  ~SorngCapsuleDatagramClientSocket() override;
+  int Connect(const IPEndPoint& address) override;
+  int ConnectUsingNetwork(handles::NetworkHandle, const IPEndPoint&) override;
+  int ConnectUsingDefaultNetwork(const IPEndPoint&) override;
+  int ConnectAsync(const IPEndPoint&, CompletionOnceCallback) override;
+  int ConnectUsingNetworkAsync(handles::NetworkHandle,
+                               const IPEndPoint&,
+                               CompletionOnceCallback) override;
+  int ConnectUsingDefaultNetworkAsync(const IPEndPoint&,
+                                      CompletionOnceCallback) override;
+  handles::NetworkHandle GetBoundNetwork() const override;
+  void ApplySocketTag(const SocketTag&) override;
+  int SetMulticastInterface(uint32_t) override;
+  void SetIOSNetworkServiceType(int) override;
+  void Close() override;
+  int GetPeerAddress(IPEndPoint*) const override;
+  int GetLocalAddress(IPEndPoint*) const override;
+  void UseNonBlockingIO() override;
+  int SetDoNotFragment() override;
+  int SetRecvTos() override;
+  int SetTos(DiffServCodePoint, EcnCodePoint) override;
+  void SetMsgConfirm(bool) override;
+  const NetLogWithSource& NetLog() const override;
+  DscpAndEcn GetLastTos() const override;
+  int Read(IOBuffer*, int, CompletionOnceCallback) override;
+  base::expected<DatagramsMetadata, Error> ReadMultiple(
+      IOBuffer*,
+      size_t,
+      size_t,
+      base::OnceCallback<void(base::expected<DatagramsMetadata, Error>)>)
+      override;
+  int Write(IOBuffer*,
+            int,
+            CompletionOnceCallback,
+            const NetworkTrafficAnnotationTag&) override;
+  int SetReceiveBufferSize(int32_t) override;
+  int SetSendBufferSize(int32_t) override;
+
+ private:
+  enum class State { kNew, kConnecting, kRequest, kResponse, kOpen, kClosed };
+  bool Active() const;
+  int ConnectLoop(int);
+  void OnConnect(int);
+  int WriteLoop(int);
+  void OnWrite(int);
+  int ReadLoop(int);
+  void OnRead(int);
+  int ParseResponse();
+  int ParseCapsules();
+  int TakeDatagram(IOBuffer*, int);
+  void Fail(int);
+  void OnRevoked();
+  const scoped_refptr<SorngDatagramProxy> proxy_;
+  const HostPortPair destination_;
+  const raw_ptr<ClientSocketFactory> factory_;
+  std::unique_ptr<StreamSocket> stream_;
+  State state_ = State::kNew;
+  scoped_refptr<IOBufferWithSize> receive_;
+  scoped_refptr<DrainableIOBuffer> send_;
+  std::string input_;
+  std::deque<std::string> datagrams_;
+  CompletionOnceCallback connect_callback_;
+  CompletionOnceCallback read_callback_;
+  CompletionOnceCallback write_callback_;
+  raw_ptr<IOBuffer> read_buffer_ = nullptr;
+  int read_length_ = 0;
+  int write_length_ = 0;
+  int error_ = ERR_SOCKET_NOT_CONNECTED;
+  // Dummy log deliberately prevents secrets leaking through socket byte logs.
+  NetLogWithSource net_log_;
+  base::OneShotTimer connect_timer_;
+  ReadMultipleEmulator multiple_{this};
+  base::WeakPtrFactory<SorngCapsuleDatagramClientSocket> weak_factory_{this};
+};
+}  // namespace net
+#endif
