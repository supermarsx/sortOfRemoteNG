+namespace {
+class OwnedAdmission final : public SSLClientContext::TlsAdmissionDelegate {
+ public:
+  bool IsActive() const override { return active; }
+  void AddSocket(const void*, base::RepeatingClosure) override {}
+  void RemoveSocket(const void*) override {}
+  void Verify(const HostPortPair& destination, scoped_refptr<X509Certificate> peer,
+      const CertVerifyResult&, int native_error, bool fatal,
+      CompletionOnceCallback callback) override {
+    ++calls;
+    EXPECT_EQ(destination.host(), kTestHostname);
+    EXPECT_EQ(destination.port(), kTestPort);
+    EXPECT_TRUE(peer);
+    saw_native_error = native_error;
+    saw_fatal = fatal;
+    // Test delegate never permits a native failure, even if a caller asks it.
+    std::move(callback).Run(active && permit && native_error == OK ? OK :
+                           ERR_BLOCKED_BY_CLIENT);
+  }
+  int calls = 0;
+  int saw_native_error = OK;
+  bool saw_fatal = false;
+  bool active = true;
+  bool permit = false;
+ private:
+  ~OwnedAdmission() override = default;
+};
+class OwnedProofCallback final : public quic::ProofVerifierCallback {
+ public:
+  explicit OwnedProofCallback(std::optional<bool>* result) : result_(result) {}
+  void Run(bool ok, const std::string&,
+           std::unique_ptr<quic::ProofVerifyDetails>*) override { *result_ = ok; }
+ private:
+  raw_ptr<std::optional<bool>> result_;
+};
+}  // namespace
+
+TEST_F(ProofVerifierChromiumTest, OwnedAdmissionWaitsAndPreservesNativeFailures) {
+  auto admission = base::MakeRefCounted<OwnedAdmission>();
+  for (const int native_error : {OK, ERR_CERT_AUTHORITY_INVALID}) {
+    MockCertVerifier native_verifier;
+    auto result = dummy_result_;
+    result.is_issued_by_known_root = false;
+    if (native_error != OK) result.cert_status = CERT_STATUS_AUTHORITY_INVALID;
+    native_verifier.AddResultForCert(test_cert_.get(), result, native_error);
+    ProofVerifierChromium verifier(&native_verifier, &transport_security_state_,
+        nullptr, {}, NetworkAnonymizationKey(), admission);
+    for (const bool permit : {false, true}) {
+      admission->permit = permit;
+      std::optional<bool> completed;
+      auto status = verifier.VerifyCertChain(kTestHostname, kTestPort,
+          std::vector<std::string_view>(certs_.begin(), certs_.end()), "", "",
+          verify_context_.get(), &error_details_, &details_, &tls_alert_,
+          std::make_unique<OwnedProofCallback>(&completed));
+      EXPECT_EQ(quic::QUIC_PENDING, status);
+      EXPECT_FALSE(completed.has_value());
+      task_environment_.RunUntilIdle();
+      ASSERT_TRUE(completed.has_value());
+      EXPECT_EQ(native_error == OK && permit, *completed);
+      EXPECT_EQ(native_error, admission->saw_native_error);
+    }
+  }
+  EXPECT_EQ(4, admission->calls);
+}
+
+TEST_F(ProofVerifierChromiumTest, OwnedAdmissionRevocationRejectsPostedSuccess) {
+  auto admission = base::MakeRefCounted<OwnedAdmission>();
+  admission->permit = true;
+  MockCertVerifier native_verifier;
+  native_verifier.AddResultForCert(test_cert_.get(), dummy_result_, OK);
+  ProofVerifierChromium verifier(&native_verifier, &transport_security_state_,
+      nullptr, {}, NetworkAnonymizationKey(), admission);
+  std::optional<bool> completed;
+  EXPECT_EQ(quic::QUIC_PENDING, verifier.VerifyCertChain(kTestHostname, kTestPort,
+      std::vector<std::string_view>(certs_.begin(), certs_.end()), "", "",
+      verify_context_.get(), &error_details_, &details_, &tls_alert_,
+      std::make_unique<OwnedProofCallback>(&completed)));
+  admission->active = false;
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(completed.has_value());
+  EXPECT_FALSE(*completed);
+}
