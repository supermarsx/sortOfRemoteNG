+namespace net {
+namespace {
+class Admission final : public SSLClientContext::TlsAdmissionDelegate {
+ public:
+  bool IsActive() const override { return active; }
+  void Verify(const HostPortPair&,
+              scoped_refptr<X509Certificate>,
+              const CertVerifyResult&,
+              int,
+              bool,
+              CompletionOnceCallback cb) override {
+    std::move(cb).Run(active ? OK : ERR_ABORTED);
+  }
+  void AddSocket(const void* key, base::RepeatingClosure cb) override {
+    callbacks.emplace(key, std::move(cb));
+  }
+  void RemoveSocket(const void* key) override { callbacks.erase(key); }
+  void Revoke() {
+    active = false;
+    auto copy = callbacks;
+    for (const auto& item : copy) {
+      item.second.Run();
+    }
+  }
+  bool active = true;
+  std::map<const void*, base::RepeatingClosure> callbacks;
+
+ private:
+  ~Admission() override = default;
+};
+constexpr char kResponse[] =
+    "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: "
+    "connect-udp\r\nCapsule-Protocol: ?1\r\n\r\n";
+class SorngCapsuleSocketTest : public testing::Test {
+ protected:
+  std::string Request(std::string_view host = "example.test") {
+    return "GET /.well-known/masque/udp/" + std::string(host) +
+           "/443/ HTTP/1.1\r\nHost: 127.0.0.1:32123\r\nProxy-Authorization: "
+           "Basic " +
+           base::Base64Encode("sorng-private-proxy:" + std::string(64, 'a')) +
+           "\r\nConnection: Upgrade\r\nUpgrade: "
+           "connect-udp\r\nCapsule-Protocol: ?1\r\n\r\n";
+  }
+  std::unique_ptr<SorngCapsuleDatagramClientSocket> Socket(
+      HostPortPair target = HostPortPair("example.test", 443)) {
+    return std::make_unique<SorngCapsuleDatagramClientSocket>(
+        proxy_, std::move(target), &factory_);
+  }
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  scoped_refptr<Admission> admission_ = base::MakeRefCounted<Admission>();
+  scoped_refptr<SorngDatagramProxy> proxy_ =
+      SorngDatagramProxy::Create(32123, std::string(64, 'a'), admission_);
+  MockClientSocketFactory factory_;
+};
+TEST_F(SorngCapsuleSocketTest, RejectsCredentialsAndWrongEndpointWithoutDial) {
+  EXPECT_FALSE(SorngDatagramProxy::Create(0, std::string(64, 'a'), admission_));
+  EXPECT_FALSE(
+      SorngDatagramProxy::Create(32123, std::string(64, 'x'), admission_));
+  TestCompletionCallback cb;
+  auto socket = Socket();
+  EXPECT_EQ(ERR_INVALID_ARGUMENT,
+            socket->ConnectAsync(IPEndPoint(IPAddress::IPv4Localhost(), 32124),
+                                 cb.callback()));
+  admission_->Revoke();
+  EXPECT_EQ(ERR_ABORTED,
+            socket->ConnectAsync(proxy_->endpoint(), cb.callback()));
+}
+TEST_F(SorngCapsuleSocketTest,
+       UpgradePreservesCoalescedCapsuleAndExactDatagram) {
+  const std::string request = Request();
+  std::string response = kResponse;
+  response.append(
+      "\x00\x04\x00"
+      "abc",
+      6);
+  const std::string outgoing(
+      "\x00\x04\x00"
+      "xyz",
+      6);
+  MockRead reads[] = {MockRead(ASYNC, response)};
+  MockWrite writes[] = {MockWrite(ASYNC, request), MockWrite(ASYNC, outgoing)};
+  StaticSocketDataProvider data(reads, writes);
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket();
+  TestCompletionCallback cb;
+  int result = socket->ConnectAsync(proxy_->endpoint(), cb.callback());
+  ASSERT_EQ(OK, cb.GetResult(result));
+  auto buffer = base::MakeRefCounted<IOBufferWithSize>(32);
+  ASSERT_EQ(3, socket->Read(buffer.get(), 32, cb.callback()));
+  EXPECT_EQ("abc", std::string(buffer->data(), 3));
+  auto payload = base::MakeRefCounted<StringIOBuffer>("xyz");
+  result = socket->Write(payload.get(), 3, cb.callback(),
+                         TRAFFIC_ANNOTATION_FOR_TESTS);
+  EXPECT_EQ(3, cb.GetResult(result));
+  EXPECT_TRUE(data.AllReadDataConsumed());
+  EXPECT_TRUE(data.AllWriteDataConsumed());
+}
+TEST_F(SorngCapsuleSocketTest,
+       FragmentedUpgradeDiscardsUnknownCapsulesAndContexts) {
+  const std::string request = Request();
+  const std::string header = kResponse;
+  std::string tail = header.substr(17);
+  tail.append(
+      "\x01\x02"
+      "zz",
+      4);
+  tail.append(
+      "\x00\x02\x01"
+      "z",
+      4);
+  tail.append(
+      "\x00\x04\x00"
+      "abc",
+      6);
+  const std::string first = header.substr(0, 17);
+  MockRead reads[] = {MockRead(ASYNC, first), MockRead(ASYNC, tail)};
+  MockWrite writes[] = {MockWrite(ASYNC, request)};
+  StaticSocketDataProvider data(reads, writes);
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket();
+  TestCompletionCallback cb;
+  ASSERT_EQ(OK, cb.GetResult(
+                    socket->ConnectAsync(proxy_->endpoint(), cb.callback())));
+  auto buffer = base::MakeRefCounted<IOBufferWithSize>(32);
+  ASSERT_EQ(3, socket->Read(buffer.get(), 32, cb.callback()));
+  EXPECT_EQ("abc", std::string(buffer->data(), 3));
+  EXPECT_TRUE(data.AllReadDataConsumed());
+}
+TEST_F(SorngCapsuleSocketTest, MalformedDatagramCapsuleFailsClosed) {
+  const std::string request = Request();
+  std::string response = kResponse;
+  response.append("\x00\x00", 2);  // DATAGRAM without any context ID.
+  MockRead reads[] = {MockRead(ASYNC, response)};
+  MockWrite writes[] = {MockWrite(ASYNC, request)};
+  StaticSocketDataProvider data(reads, writes);
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket();
+  TestCompletionCallback cb;
+  EXPECT_EQ(ERR_INVALID_RESPONSE, cb.GetResult(socket->ConnectAsync(
+                                      proxy_->endpoint(), cb.callback())));
+}
+
+TEST_F(SorngCapsuleSocketTest,
+       OversizeDatagramNeverWritesBeyondNativeRouteCap) {
+  const std::string request = Request();
+  MockRead reads[] = {MockRead(ASYNC, kResponse)};
+  MockWrite writes[] = {MockWrite(ASYNC, request)};
+  StaticSocketDataProvider data(reads, writes);
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket();
+  TestCompletionCallback cb;
+  ASSERT_EQ(OK, cb.GetResult(
+                    socket->ConnectAsync(proxy_->endpoint(), cb.callback())));
+  auto payload = base::MakeRefCounted<IOBufferWithSize>(1233);
+  EXPECT_EQ(ERR_MSG_TOO_BIG, socket->Write(payload.get(), 1233, cb.callback(),
+                                           TRAFFIC_ANNOTATION_FOR_TESTS));
+  EXPECT_TRUE(data.AllWriteDataConsumed());
+}
+
+TEST_F(SorngCapsuleSocketTest, NumericIpv6PathNeverResolvesOrigin) {
+  const std::string request = Request("%3A%3A1");
+  MockRead reads[] = {MockRead(ASYNC, kResponse)};
+  MockWrite writes[] = {MockWrite(ASYNC, request)};
+  StaticSocketDataProvider data(reads, writes);
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket(HostPortPair("::1", 443));
+  TestCompletionCallback cb;
+  EXPECT_EQ(OK, cb.GetResult(
+                    socket->ConnectAsync(proxy_->endpoint(), cb.callback())));
+  EXPECT_TRUE(data.AllWriteDataConsumed());
+}
+TEST_F(SorngCapsuleSocketTest,
+       RefusesNonUpgradeAndRevocationCancelsPendingConnect) {
+  const std::string request = Request();
+  MockRead reads[] = {MockRead(ASYNC, "HTTP/1.1 200 OK\r\n\r\n")};
+  MockWrite writes[] = {MockWrite(ASYNC, request)};
+  StaticSocketDataProvider data(reads, writes);
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket();
+  TestCompletionCallback cb;
+  EXPECT_EQ(ERR_INVALID_RESPONSE, cb.GetResult(socket->ConnectAsync(
+                                      proxy_->endpoint(), cb.callback())));
+  StaticSocketDataProvider pending;
+  pending.set_connect_data(MockConnect(ASYNC, ERR_IO_PENDING));
+  factory_.AddSocketDataProvider(&pending);
+  auto pending_socket = Socket();
+  TestCompletionCallback aborted;
+  ASSERT_EQ(ERR_IO_PENDING, pending_socket->ConnectAsync(proxy_->endpoint(),
+                                                         aborted.callback()));
+  admission_->Revoke();
+  EXPECT_EQ(ERR_ABORTED, aborted.WaitForResult());
+}
+TEST_F(SorngCapsuleSocketTest, NativeUpgradeDeadlineIsBounded) {
+  StaticSocketDataProvider data;
+  data.set_connect_data(MockConnect(ASYNC, ERR_IO_PENDING));
+  factory_.AddSocketDataProvider(&data);
+  auto socket = Socket();
+  TestCompletionCallback cb;
+  ASSERT_EQ(ERR_IO_PENDING,
+            socket->ConnectAsync(proxy_->endpoint(), cb.callback()));
+  task_environment_.FastForwardBy(base::Seconds(10));
+  EXPECT_EQ(ERR_TIMED_OUT, cb.WaitForResult());
+}
