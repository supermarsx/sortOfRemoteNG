+bool NetworkContext::ConfigureSorngDatagrams(uint16_t proxy_port,
+                                            std::string password) {
+  if (!url_request_context_ || !params_->sorng_tls_generation) return false;
+  auto* session = url_request_context_->http_transaction_factory()->GetSession();
+  if (!session) return false;
+  net::ConfiguredProxyResolutionService* service = nullptr;
+  net::ProxyInfo fixed;
+  if (!url_request_context_->proxy_resolution_service()
+           ->CastToConfiguredProxyResolutionService(&service) ||
+      !service->GetSorngFixedProxy(proxy_port, &fixed)) return false;
+  auto proxy = net::SorngDatagramProxy::Create(
+      proxy_port, std::move(password),
+      session->ssl_client_context()->tls_admission_delegate());
+  return proxy && session->ConfigureSorngDatagrams(std::move(proxy));
+}
