+TEST_F(HostResolverManagerTest, SkipIPv6ReachabilityProbeForLoopbackProxy) {
+  AddScopedFeatureList().InitFromCommandLine("SkipIPv6ReachabilityProbe", "");
+  DestroyResolver();
+  resolver_ = std::make_unique<HostResolverManager>(
+      DefaultOptions(), nullptr /* system_dns_config_notifier */,
+      nullptr /* net_log */);
+  RecordingNetLogObserver net_log_observer;
+  NetLogWithSource net_log =
+      NetLogWithSource::Make(net::NetLog::Get(), NetLogSourceType::NONE);
+  // No socket data providers: trying to create a probe socket fails the test.
+  MockClientSocketFactory socket_factory;
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    resolver_->ResetIPv6ProbeTimeForTesting();
+    EXPECT_EQ(OK, StartIPv6ReachabilityCheck(
+                      handles::kInvalidNetworkHandle, net_log, &socket_factory,
+                      base::BindOnce([](int) { ADD_FAILURE(); })));
+    // False prevents a second NAT64 route probe for the IPv4 loopback relay.
+    EXPECT_FALSE(GetLastIpv6ProbeResult());
+  }
+  auto events = net_log_observer.GetEntriesWithType(
+      NetLogEventType::HOST_RESOLVER_MANAGER_IPV6_REACHABILITY_CHECK);
+  ASSERT_EQ(2U, events.size());
+  for (const auto& event : events) {
+    EXPECT_TRUE(GetBooleanValueFromParams(event, "skipped_for_proxy"));
+    EXPECT_FALSE(GetBooleanValueFromParams(event, "ipv6_available"));
+  }
+}
