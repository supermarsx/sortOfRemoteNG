+// Existing directory that is neither a symlink, a junction nor any other
+// reparse point. Never follows the final component.
+bool IsPlainDirectory(const base::FilePath& path) {
+#if BUILDFLAG(IS_WIN)
+  const DWORD attributes = ::GetFileAttributesW(path.value().c_str());
+  return attributes != INVALID_FILE_ATTRIBUTES &&
+         (attributes & FILE_ATTRIBUTE_DIRECTORY) &&
+         !(attributes & FILE_ATTRIBUTE_REPARSE_POINT);
+#else
+  struct stat info;
+  return lstat(path.value().c_str(), &info) == 0 && S_ISDIR(info.st_mode);
+#endif
+}
+
+// The candidate prefix names the actual normalized CefSettings.root_cache_path.
+// POSIX CEF stores root_cache_path realpath-resolved, so a caller spelling
+// through a symlinked ancestor of the root is resolved here; nothing at or
+// below <root>/http-cache is ever resolved.
+bool IsRootCachePath(const base::FilePath& prefix, const base::FilePath& root) {
+#if BUILDFLAG(IS_WIN)
+  return base::FilePath::CompareEqualIgnoreCase(prefix.value(), root.value());
+#else
+  return prefix == root || base::MakeAbsoluteFilePath(prefix) == root;
+#endif
+}
+
+std::optional<HttpCacheGrant> ValidateHttpCache(
+    const cef_sorng_http_cache_v2* cache) {
+  if (!cache || cache->size != sizeof(*cache) || cache->reserved ||
+      !sorng_tls::HttpCacheSizeAllowed(cache->max_bytes) ||
+      !cache->directory_utf8 || !cache->directory_length ||
+      cache->directory_length > sorng_tls::kMaxHttpCachePathBytes)
+    return std::nullopt;
+  constexpr auto kStyle = sorng_tls::kNativePathStyle;
+  sorng_tls::ParsedPath parsed;
+  if (!sorng_tls::ParseAbsolutePath(
+          std::string_view(cache->directory_utf8, cache->directory_length),
+          kStyle, parsed))
+    return std::nullopt;
+  auto* context = CefContext::Get();
+  if (!context)
+    return std::nullopt;
+  // Normalized by CefContext::Initialize (absolute, no trailing separator).
+  const base::FilePath root =
+      base::FilePath(CefString(&context->settings().root_cache_path));
+  if (root.empty() || !root.IsAbsolute())
+    return std::nullopt;
+  // Bounded metadata-only checks of a few local directories; CEF validates its
+  // own cache paths on this thread the same way (context.cc).
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  for (const size_t split : sorng_tls::HttpCacheRootSplits(parsed, kStyle)) {
+    if (!IsRootCachePath(
+            base::FilePath::FromUTF8Unsafe(parsed.Join(split, kStyle)), root))
+      continue;
+    // Rebuild below the canonical root and check http-cache and every
+    // component under it: each must already be a plain directory.
+    base::FilePath directory = root;
+    for (size_t i = split; i < parsed.components.size(); ++i) {
+      directory =
+          directory.Append(base::FilePath::FromUTF8Unsafe(parsed.components[i]));
+      if (!IsPlainDirectory(directory))
+        return std::nullopt;
+    }
+    return HttpCacheGrant{
+        directory,
+        sorng_tls::HttpCacheDirectoryKey(root.AsUTF8Unsafe(), parsed, split,
+                                         kStyle),
+        cache->max_bytes};
+  }
+  return std::nullopt;
+}
