{
  "$schema": "../../../types/connection/httpLoginSteps.schema.json",
  "version": 1,
  "id": "time4vps",
  "evidence": {
    "class": "A",
    "source": "tests/fixtures/logins/time4vps/capture.json",
    "reviewed": "2026-10-14"
  },
  "credentialOrigins": ["https://billing.time4vps.com"],
  "loginSteps": [
    {
      "kind": "form",
      "origin": "https://billing.time4vps.com",
      "paths": ["/clientarea/"],
      "selectors": {
        "username": "form#login-widget-form input#login-widget-user[name=\"username\"][type=\"text\"][required]",
        "password": "form#login-widget-form input#login-widget-password[name=\"password\"][type=\"password\"][autocomplete=\"off\"][required]"
      }
    },
    {
      "kind": "submit",
      "submission": "click",
      "selectors": {
        "control": "form#login-widget-form button#login-widget-submit[type=\"submit\"]"
      }
    }
  ]
}
