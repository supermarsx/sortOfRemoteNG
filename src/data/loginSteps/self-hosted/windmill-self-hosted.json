{
  "$schema": "../../../types/connection/httpLoginSteps.schema.json",
  "version": 1,
  "id": "windmill-self-hosted",
  "evidence": {
    "class": "A",
    "source": "https://github.com/windmill-labs/windmill/blob/9202a74071ba424ad6cfc1cfded518ee7db002dc/frontend/src/lib/components/Login.svelte",
    "reviewed": "2026-10-29"
  },
  "credentialOrigins": [],
  "loginSteps": [
    {
      "kind": "form",
      "paths": ["/user/login"],
      "selectors": {
        "username": "input[type=\"email\"]:is([id$=\"-email\"][autocomplete=\"username\"],#email:is([autocomplete=\"email\"],[autocomplete=\"username\"]))",
        "password": "input[type=\"password\"][autocomplete=\"current-password\"]:is([id$=\"-password\"],#password)"
      }
    },
    {
      "kind": "submit",
      "submission": "enter"
    }
  ]
}
