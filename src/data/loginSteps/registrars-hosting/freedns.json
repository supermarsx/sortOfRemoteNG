{
  "$schema": "../../../types/connection/httpLoginSteps.schema.json",
  "version": 1,
  "id": "freedns",
  "evidence": {
    "class": "B",
    "source": "https://github.com/acmesh-official/acme.sh/blob/807da6498377ee5e0cf43a78091f46f12dc59a89/dnsapi/dns_freedns.sh",
    "reviewed": "2026-10-12"
  },
  "credentialOrigins": [],
  "loginSteps": [
    {
      "kind": "form",
      "paths": ["/zc.php"],
      "selectors": {
        "username": "form[action*=\"zc.php\"]:has(input[type=\"hidden\"][name=\"action\"][value=\"auth\"]) input[name=\"username\"]",
        "password": "form[action*=\"zc.php\"]:has(input[type=\"hidden\"][name=\"action\"][value=\"auth\"]) input[name=\"password\"][type=\"password\"]"
      }
    },
    { "kind": "submit", "submission": "enter" }
  ]
}
