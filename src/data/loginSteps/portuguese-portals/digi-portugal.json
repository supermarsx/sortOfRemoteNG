{
  "$schema": "../../../types/connection/httpLoginSteps.schema.json",
  "version": 1,
  "id": "digi-portugal",
  "evidence": {
    "class": "B",
    "source": "https://mydigi.digi.pt/",
    "reviewed": "2026-10-12"
  },
  "credentialOrigins": [],
  "loginSteps": [
    {
      "kind": "form",
